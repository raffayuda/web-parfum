---
import Button from './ui/Button.astro';
import Eyebrow from './ui/Eyebrow.astro';
import Media from './ui/Media.astro';
import Section from './ui/Section.astro';
import { images, alts } from '../data/images';
import { priceLabel } from '../data/fragrances';
import { whatsappHref } from '../data/site';
import { AddToCartButton } from './cart/AddToCartButton';

interface Props {
  class?: string;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  price?: number;
  ctaText?: string;
}

const {
  class: className,
  eyebrow = 'Discovery set',
  title = 'Four scents. One week.',
  subtitle = 'Empat komposisi OMOO 30 ml dalam vial 2 ml. Coba langsung di kulit Anda sebelum memilih flacon penuh.',
  price = 195000,
  ctaText = 'Pesan Discovery Set',
} = Astro.props;
---

<Section tone="tint" spacing="tight" class:list={['relative overflow-hidden', className]}>
  <div
    data-mist
    aria-hidden="true"
    class="pointer-events-none absolute -right-28 -top-24 h-[26rem] w-[26rem] rounded-full bg-accent-fill/30 blur-[90px]"
  ></div>

  <div class="relative grid min-w-0 items-stretch lg:grid-cols-2">
    <Media
      src={images.discoverySet}
      alt={alts.discoverySet}
      aspect="4 / 3"
      widths={[480, 720, 980]}
      sizes="(max-width: 1024px) 100vw, 50vw"
      parallax
      reveal
    />

    <div class="flex min-w-0 flex-col justify-center gap-6 p-7 md:p-10 lg:p-[clamp(2rem,4vw,4.5rem)]">
      <div data-reveal>
        <Eyebrow><span data-editable-id="discovery-eyebrow">{eyebrow}</span></Eyebrow>
      </div>
      <h2
        data-reveal-title
        class="max-w-[11ch] pb-1 font-display text-[clamp(2.4rem,4.4vw,4.1rem)] font-light leading-[0.96] tracking-[-0.02em]"
      >
        <span data-editable-id="discovery-title">{title}</span>
      </h2>
      <p data-reveal class="max-w-[42ch] text-[0.95rem] leading-[1.7] text-muted" data-editable-id="discovery-subtitle">
        {subtitle}
      </p>
      <p data-reveal class="flex items-baseline gap-3 font-display text-3xl">
        <span data-editable-id="discovery-price">{priceLabel(price)}</span>
        <span class="font-sans text-[0.7rem] uppercase tracking-[0.08em] text-muted">
          Empat vial 2 ml
        </span>
      </p>
      <div data-reveal class="flex flex-wrap items-center gap-3">
        <AddToCartButton
          client:load
          product={{
            slug: 'discovery-set',
            name: 'OMOO Discovery Set',
            edition: 'SET-04',
            volume: '4 x 2 ml Vial',
            price: price,
            bottleImage: '/images/products/trio-editorial.webp',
          }}
          openDrawerAfterAdd
          className="px-6 py-4"
        />
        <Button
          href={whatsappHref(
            `Halo OMOO, saya ingin memesan Discovery Set (${priceLabel(price)}). Mohon info ketersediaan dan pengiriman.`
          )}
          external
          variant="ghost"
          class="w-full sm:w-auto"
        >
          <span data-editable-id="discovery-cta">{ctaText}</span>
        </Button>
      </div>
      <p data-reveal class="max-w-[42ch] text-[0.72rem] leading-relaxed text-muted">
        Pemesanan dan pengiriman diatur lewat WhatsApp. Kami mengirim ke seluruh Indonesia.
      </p>
    </div>
  </div>
</Section>
