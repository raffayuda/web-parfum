---
import Container from './ui/Container.astro';
import Wordmark from './ui/Wordmark.astro';
import SocialLinks from './ui/SocialLinks.astro';
import { site } from '../data/site';
import { prisma } from '../../server/src/db';
import { defaultSettings } from '../../server/src/routes/settings';

const year = new Date().getFullYear();

let settings: any = { ...defaultSettings };

try {
  const page = await prisma.page.findUnique({
    where: { slug: 'site-settings' },
    include: { sections: true },
  });
  if (page && page.sections.length > 0) {
    const c = (page.sections[0].contentData as any) || {};
    settings = { ...defaultSettings, ...c };
  }
} catch (e) {}

const getTxt = (key: string, fallback: string) =>
  String(settings[key] || fallback)
    .replace(/\bAtelier\b/g, 'Studio')
    .replace(/\batelier\b/g, 'studio');
---

<footer class="mt-12 border-t border-line bg-bg-tint md:mt-20">
  <Container>
    <div class="grid gap-12 py-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-24 lg:py-24">
      <div class="flex flex-col items-start gap-6">
        <img
          src="/images/omoo-full-black.svg"
          alt="O.M.OO"
          class="h-16 sm:h-20 w-auto object-contain block dark:hidden"
        />
        <img
          src="/images/omoo-full-gold.svg"
          alt="O.M.OO"
          class="h-16 sm:h-20 w-auto object-contain hidden dark:block"
        />
        <p
          class="max-w-[20ch] font-display text-[clamp(1.9rem,3.2vw,3.1rem)] font-light leading-[1.03] tracking-[-0.015em]"
          data-editable-id="footer-headline"
        >
          {getTxt('footerHeadline', 'Perfume made in small batches.\nDiracik perlahan di Jakarta, dari material pilihan.')}
        </p>
        <a
          class="group/link inline-flex items-center gap-2 border-b border-line pb-1.5 text-[0.7rem] font-medium uppercase leading-tight tracking-[0.14em] transition-colors duration-300 ease-luxe hover:border-accent hover:text-accent"
          href="/contact/"
        >
          Contact
          <span
            aria-hidden="true"
            class="transition-transform duration-300 ease-luxe group-hover/link:translate-x-1"
          >
            &#8594;
          </span>
        </a>
      </div>

      <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 sm:gap-8">
        <div>
          <p class="mb-4 text-[0.65rem] font-medium uppercase tracking-[0.15em] text-muted">Explore</p>
          <ul class="grid gap-2">
            {
              [
                ['/collection', 'Collection'],
                ['/find', 'Find your scent'],
                ['/about', 'About Us'],
                ['/gallery', 'Gallery'],
                ['/account/orders', 'My Orders'],
                ['/member', 'Membership'],
                ['/admin', 'Portal Admin'],
              ].map(([href, label]) => (
                <li>
                  <a
                    href={href}
                    class="text-[0.9rem] leading-relaxed text-muted transition-colors duration-300 hover:text-ink"
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <p class="mb-4 text-[0.65rem] font-medium uppercase tracking-[0.15em] text-muted">Studio</p>
          <address class="text-[0.9rem] leading-relaxed text-muted not-italic">
            <span data-editable-id="footer-street">{getTxt('street', site.address.street)}</span><br />
            <span data-editable-id="footer-city">{getTxt('city', site.address.city)}</span><br />
            <span data-editable-id="footer-country">{getTxt('country', site.address.country)}</span>
          </address>
          <p class="mt-3 text-[0.75rem] leading-relaxed text-muted" data-editable-id="footer-visit-note">
            {getTxt('visitNote', 'Kunjungan dengan janji temu')}
          </p>
          {settings.hours && (
            <p class="mt-1 text-[0.7rem] text-accent tracking-wide" data-editable-id="footer-hours">
              {getTxt('hours', settings.hours)}
            </p>
          )}
        </div>

        <div class="col-span-2 sm:col-span-1">
          <p class="mb-4 text-[0.65rem] font-medium uppercase tracking-[0.15em] text-muted">Kontak</p>
          <a
            href={`mailto:${getTxt('email', site.email)}`}
            class="w-fit border-b border-line pb-0.5 text-[0.9rem] text-muted transition-colors hover:border-accent hover:text-ink"
            data-editable-id="footer-email"
          >
            {getTxt('email', site.email)}
          </a>
          <p class="mt-3 max-w-[28ch] text-[0.75rem] leading-relaxed text-muted" data-editable-id="footer-email-note">
            {getTxt('footerEmailNote', 'Kami membalas dalam 1-2 hari kerja.')}
          </p>
          {settings.phone && (
            <p class="mt-2 text-[0.75rem] text-muted">
              WhatsApp: <span data-editable-id="footer-phone">{getTxt('phone', settings.phone)}</span>
            </p>
          )}
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-6 border-t border-line py-8 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-[0.62rem] font-medium uppercase tracking-[0.15em] text-muted">Media Sosial</p>
        <p class="mt-2 max-w-[28ch] font-display text-2xl font-light leading-tight" data-editable-id="footer-social-heading">
          {getTxt('footerSocialHeading', 'Kabar terbaru dan catatan aroma OMOO.')}
        </p>
      </div>
      <SocialLinks variant="tiles" whatsapp showHandle />
    </div>

    <Wordmark
      variant="footer"
      class="pt-4 pb-2"
    />

    <div
      class="flex flex-wrap justify-between gap-x-8 gap-y-3 border-t border-line pb-24 pt-6 text-[0.68rem] uppercase tracking-[0.08em] text-muted md:pb-24 md:pt-7"
    >
      <p data-editable-id="footer-copyright">&copy; {year} {getTxt('brandName', 'Omoo Parfums')}</p>
      <p data-editable-id="footer-location">{getTxt('city', 'Jakarta, Indonesia')}</p>
      <p>All rights reserved</p>
    </div>
  </Container>
</footer>
