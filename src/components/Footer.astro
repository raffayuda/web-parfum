---
import Container from './ui/Container.astro';
import Wordmark from './ui/Wordmark.astro';

const year = new Date().getFullYear();
---

<footer class="mt-12 border-t border-line bg-bg-tint md:mt-20">
  <Container>
    <div class="grid gap-12 py-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-24 lg:py-24">
      <div class="flex flex-col items-start gap-8">
        <p class="max-w-[20ch] font-display text-[clamp(1.9rem,3.2vw,3.1rem)] font-light leading-[1.03] tracking-[-0.015em]">
          Perfume made in small batches,<br />
          between Grasse and Paris.
        </p>
        <a
          class="group/link inline-flex items-center gap-2 border-b border-line pb-1.5 text-[0.7rem] font-medium uppercase leading-tight tracking-[0.14em] transition-colors duration-300 ease-luxe hover:border-accent hover:text-accent"
          href="/contact/"
        >
          Contact
          <span
            aria-hidden="true"
            class="transition-transform duration-300 ease-luxe group-hover/link:translate-x-1"
          >
            &#8594;
          </span>
        </a>
      </div>

      <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 sm:gap-8">
        <div>
          <p class="mb-4 text-[0.65rem] font-medium uppercase tracking-[0.15em] text-muted">Explore</p>
          <ul class="grid gap-2">
            {
              [
                ['/collection', 'Collection'],
                ['/find', 'Find your scent'],
                ['/maison', 'Maison'],
                ['/journal', 'Journal'],
              ].map(([href, label]) => (
                <li>
                  <a
                    href={href}
                    class="text-[0.9rem] leading-relaxed text-muted transition-colors duration-300 hover:text-ink"
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <p class="mb-4 text-[0.65rem] font-medium uppercase tracking-[0.15em] text-muted">Atelier</p>
          <address class="text-[0.9rem] leading-relaxed text-muted">
            14 rue de Poitou<br />
            75003 Paris<br />
            France
          </address>
          <p class="mt-3 text-[0.75rem] leading-relaxed text-muted">Visits by appointment</p>
        </div>

        <div class="col-span-2 sm:col-span-1">
          <p class="mb-4 text-[0.65rem] font-medium uppercase tracking-[0.15em] text-muted">Correspondence</p>
          <a
            href="mailto:hello@omoo.studio"
            class="inline-block border-b border-line pb-0.5 text-[0.9rem] text-muted transition-colors hover:border-accent hover:text-ink"
          >
            hello@omoo.studio
          </a>
          <p class="mt-3 text-[0.75rem] leading-relaxed text-muted">
            We answer within two working days.
          </p>
        </div>
      </div>
    </div>

    <Wordmark
      class="block overflow-hidden whitespace-nowrap pt-2 text-[clamp(4rem,17.5vw,16rem)] leading-[0.72] tracking-[0.12em] -translate-x-[0.06em]"
    />

    <div
      class="flex flex-wrap justify-between gap-x-8 gap-y-3 border-t border-line py-6 text-[0.68rem] uppercase tracking-[0.08em] text-muted md:py-7"
    >
      <p>&copy; {year} Omoo Parfums</p>
      <p>Paris, France</p>
      <p>All rights reserved</p>
    </div>
  </Container>
</footer>
