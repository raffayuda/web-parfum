---
interface Props {
  tone?: 'default' | 'inverse';
  class?: string;
}

const { tone = 'default', class: className } = Astro.props;

const tones = {
  default: 'text-muted hover:text-ink',
  inverse: 'text-[#e9eae3]/55 hover:text-[#e9eae3]',
};
---

<button
  type="button"
  data-theme-toggle
  aria-label="Switch colour theme"
  title="Ganti tema (Terang / Gelap)"
  class:list={[
    'p-1.5 rounded-full transition-colors duration-300 ease-luxe flex items-center justify-center',
    tones[tone],
    className,
  ]}
>
  <span class="inline dark:hidden" aria-label="Beralih ke mode gelap">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
    </svg>
  </span>
  <span class="hidden dark:inline" aria-label="Beralih ke mode terang">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2"></path>
      <path d="M12 20v2"></path>
      <path d="m4.93 4.93 1.41 1.41"></path>
      <path d="m17.66 17.66 1.41 1.41"></path>
      <path d="M2 12h2"></path>
      <path d="M20 12h2"></path>
      <path d="m6.34 17.66-1.41 1.41"></path>
      <path d="m19.07 4.93-1.41 1.41"></path>
    </svg>
  </span>
</button>
