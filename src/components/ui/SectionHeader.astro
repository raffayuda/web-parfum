---
import ArrowLink from './ArrowLink.astro';

interface Props {
  id?: string;
  linkHref?: string;
  linkLabel?: string;
  class?: string;
}

const { id, linkHref, linkLabel, class: className } = Astro.props;
---

<div class:list={['flex flex-col gap-6 md:flex-row md:items-end md:justify-between', className]}>
  <h2
    id={id}
    data-reveal-title
    class="max-w-[17ch] pb-1 font-display text-[clamp(2.35rem,4.8vw,4.75rem)] font-light leading-[0.98] tracking-[-0.02em] text-balance"
  >
    <slot />
  </h2>
  {
    linkHref && linkLabel && (
      <ArrowLink href={linkHref} class="shrink-0 md:mb-2" reveal>
        {linkLabel}
      </ArrowLink>
    )
  }
</div>
