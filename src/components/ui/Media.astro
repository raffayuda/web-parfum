---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  aspect?: string;
  class?: string;
  imgClass?: string;
  widths?: number[];
  sizes?: string;
  priority?: boolean;
  quality?: number;
  fill?: boolean;
  parallax?: boolean;
  tiltTarget?: boolean;
  reveal?: boolean;
}

const {
  src,
  alt,
  aspect = '4 / 5',
  class: className,
  imgClass,
  widths = [360, 540, 720, 960, 1200],
  sizes = '100vw',
  priority = false,
  quality = 82,
  fill = false,
  parallax = false,
  tiltTarget = false,
  reveal = false,
} = Astro.props;
---

<div
  class:list={['relative min-w-0 max-w-full overflow-hidden bg-surface', className]}
  style={fill ? undefined : `aspect-ratio: ${aspect};`}
  data-tilt-media={tiltTarget ? '' : undefined}
  data-reveal-image={reveal ? '' : undefined}
  data-parallax={parallax ? '' : undefined}
>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    format="webp"
    quality={quality}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    class:list={[
      fill ? 'absolute inset-0 h-full w-full object-cover' : 'h-full w-full object-cover',
      'transition-transform duration-1000 ease-luxe group-hover:scale-[1.025]',
      parallax && 'scale-[1.06] will-change-transform',
      imgClass,
    ]}
    data-parallax-image={parallax ? '' : undefined}
  />
</div>
