---
interface Props {
  href: string;
  class?: string;
  arrow?: 'right' | 'up-right' | 'none';
  reveal?: boolean;
}

const { href, class: className, arrow = 'right', reveal = false } = Astro.props;
const external = href.startsWith('http') || href.startsWith('mailto:');
---

<a
  href={href}
  class:list={[
    'group/link inline-flex items-center gap-2 border-b border-line pb-1.5 text-[0.7rem] font-medium uppercase leading-tight tracking-[0.14em] transition-colors duration-300 ease-luxe hover:border-accent hover:text-accent',
    className,
  ]}
  {...external ? { rel: href.startsWith('http') ? 'noreferrer' : undefined } : {}}
  data-reveal={reveal ? '' : undefined}
>
  <span><slot /></span>
  {
    arrow !== 'none' && (
      <span
        aria-hidden="true"
        class="transition-transform duration-300 ease-luxe group-hover/link:translate-x-1"
      >
        {arrow === 'up-right' ? '\u2197' : '\u2192'}
      </span>
    )
  }
</a>
