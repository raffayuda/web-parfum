---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import { MyOrdersPage } from '../../components/tracker/MyOrdersPage';
---

<BaseLayout
  title="My Orders — OMOO"
  description="Track your order status, courier delivery, and download official invoices for your OMOO orders."
>
  <PageHeader
    deck="Track your OMOO order status, payment verification, and courier delivery."
  >
    <Fragment slot="title">My <span class="italic">Orders</span>.</Fragment>
  </PageHeader>

  <section class="py-12 px-gutter">
    <div class="mx-auto max-w-6xl w-full">
      <MyOrdersPage client:load />
    </div>
  </section>
</BaseLayout>
