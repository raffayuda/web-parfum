---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import { MyOrdersPage } from '../../components/tracker/MyOrdersPage';
---

<BaseLayout
  title="My Orders — OMOO"
  description="Pantau perkembangan peracikan botol, rute GPS pengantaran kurir, serta unduh invoice faktur resmi pesanan wewangian OMOO Anda."
>
  <PageHeader
    deck="Pantau perjalanan wewangian Anda dari peracikan di studio Jakarta hingga tiba di tangan Anda."
  >
    <Fragment slot="title">My <span class="italic">Orders</span>.</Fragment>
  </PageHeader>

  <section class="py-12 px-gutter">
    <div class="mx-auto max-w-page">
      <MyOrdersPage client:load />
    </div>
  </section>
</BaseLayout>
