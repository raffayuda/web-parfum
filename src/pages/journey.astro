---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Media from '../components/ui/Media.astro';
import Section from '../components/ui/Section.astro';
import JournalCard from '../components/JournalCard.astro';
import { journal } from '../data/journal';
import { prisma } from '../../server/src/db';

export const prerender = false;

let dbElements: Record<string, string> = {};
let dbImages: Record<string, string> = {};

try {
  const page = await prisma.page.findFirst({
    where: { slug: { in: ['journey', 'journal'] } },
    include: { sections: true },
  });

  if (page) {
    for (const sec of page.sections) {
      const c = (sec.contentData as any) || {};
      if (c.elements) dbElements = { ...dbElements, ...c.elements };
      if (c.images) dbImages = { ...dbImages, ...c.images };
    }
  }
} catch (e) {}

const getTxt = (id: string, fallback: string) => dbElements[id] || fallback;
const getImg = (id: string, fallback: string) => dbImages[id] || fallback;

const galleryItems = [
  {
    id: 'gallery-item-1',
    title: getTxt('gallery-title-1', 'Ruang Maserasi Kaca Tebal'),
    location: getTxt('gallery-loc-1', 'Atelier Jakarta / Ruang Dingin'),
    image: getImg('gallery-img-1', '/src/assets/images/atelier.jpg'),
    aspect: '16 / 10',
    colSpan: 'md:col-span-8',
  },
  {
    id: 'gallery-item-2',
    title: getTxt('gallery-title-2', 'Koridor & Pintu Masuk'),
    location: getTxt('gallery-loc-2', 'Atelier Jakarta Selatan'),
    image: getImg('gallery-img-2', '/src/assets/images/corridor.jpg'),
    aspect: '4 / 5',
    colSpan: 'md:col-span-4',
  },
  {
    id: 'gallery-item-3',
    title: getTxt('gallery-title-3', 'Akar Vetiver Hitam'),
    location: getTxt('gallery-loc-3', 'Les Cayes, Haiti'),
    image: getImg('gallery-img-3', '/src/assets/images/macro-vetiver.jpg'),
    aspect: '1 / 1',
    colSpan: 'md:col-span-4',
  },
  {
    id: 'gallery-item-4',
    title: getTxt('gallery-title-4', 'Rimpang Iris Pallida Tiga Tahun'),
    location: getTxt('gallery-loc-4', 'San Polo in Chianti, Tuscany'),
    image: getImg('gallery-img-4', '/src/assets/images/macro-iris.jpg'),
    aspect: '1 / 1',
    colSpan: 'md:col-span-4',
  },
  {
    id: 'gallery-item-5',
    title: getTxt('gallery-title-5', 'Kayu Gaharu Alami Liar'),
    location: getTxt('gallery-loc-5', 'Pedalaman Hutan Kalimantan'),
    image: getImg('gallery-img-5', '/src/assets/images/macro-oud.jpg'),
    aspect: '1 / 1',
    colSpan: 'md:col-span-4',
  },
  {
    id: 'gallery-item-6',
    title: getTxt('gallery-title-6', 'Kemasan Botol Kaca Premium'),
    location: getTxt('gallery-loc-6', 'Meja Pembotolan'),
    image: getImg('gallery-img-6', '/src/assets/images/bottle-vetiver.jpg'),
    aspect: '4 / 5',
    colSpan: 'md:col-span-6',
  },
  {
    id: 'gallery-item-7',
    title: getTxt('gallery-title-7', 'Varian Sel Brut 50ml'),
    location: getTxt('gallery-loc-7', 'Batch Terbatas'),
    image: getImg('gallery-img-7', '/src/assets/images/bottle-sel.jpg'),
    aspect: '4 / 5',
    colSpan: 'md:col-span-6',
  },
];

const [featured, ...rest] = journal;
---

<BaseLayout
  title="The Journey & Gallery — OMOO"
  description="Catatan perjalanan peracikan wewangian, eksplorasi material, dan rekaman visual galeri dari studio OMOO di Jakarta & Grasse."
>
  <PageHeader deck={getTxt('journey-deck', 'Arsip perjalanan peracikan wewangian, eksplorasi bahan baku, dan dokumentasi visual studio OMOO.')}>
    <Fragment slot="title">
      <span data-editable-id="journey-title">{getTxt('journey-title', 'The Journey & Story.')}</span>
    </Fragment>
  </PageHeader>

  {/* ================================================================= */}
  {/* SECTION 1: VISUAL GALLERY                                         */}
  {/* ================================================================= */}
  <Section spacing="tight" class="pt-0">
    <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-line pb-6">
      <div>
        <span class="text-[0.62rem] uppercase font-bold tracking-[0.16em] text-accent block">
          Dokumentasi Visual
        </span>
        <h2 class="font-display text-[clamp(2.4rem,4.4vw,3.8rem)] font-light leading-tight mt-1" data-editable-id="gallery-main-title">
          {getTxt('gallery-main-title', 'Galeri & Proses Pembuatan')}
        </h2>
      </div>
      <p class="max-w-[42ch] text-xs text-muted leading-relaxed" data-editable-id="gallery-main-deck">
        {getTxt('gallery-main-deck', 'Tangkapan lensa dari meja formulasi, tangki maserasi dingin, hingga material mentah yang tiba di Jakarta.')}
      </p>
    </div>

    {/* Gallery Grid */}
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      {galleryItems.map((item, idx) => (
        <div class={`${item.colSpan} group border border-line bg-surface/20 p-4 space-y-3 transition-all duration-300 hover:border-ink`}>
          <div data-editable-img={`gallery-img-${idx + 1}`} class="overflow-hidden bg-bg">
            <Media
              src={item.image}
              alt={item.title}
              aspect={item.aspect}
              widths={[400, 640, 960]}
              sizes="(max-width: 768px) 100vw, 50vw"
              reveal
            />
          </div>
          <div class="flex items-baseline justify-between pt-1">
            <div>
              <h3 class="font-display text-lg text-ink font-normal" data-editable-id={`gallery-title-${idx + 1}`}>
                {item.title}
              </h3>
              <p class="text-[0.62rem] uppercase tracking-wider text-muted mt-0.5" data-editable-id={`gallery-loc-${idx + 1}`}>
                {item.location}
              </p>
            </div>
            <span class="text-[0.6rem] font-mono text-muted/60">
              0{idx + 1}
            </span>
          </div>
        </div>
      ))}
    </div>
  </Section>

  {/* ================================================================= */}
  {/* SECTION 2: FEATURED ESSAY & JOURNAL ENTRIES                       */}
  {/* ================================================================= */}
  <Section spacing="tight">
    <div class="mb-10 flex items-baseline justify-between gap-6 border-b border-line pb-4">
      <div>
        <span class="text-[0.62rem] uppercase font-bold tracking-[0.16em] text-accent block">
          Esai & Catatan Material
        </span>
        <h2 class="font-display text-2xl font-light text-ink mt-1">
          Cerita & Catatan Perjalanan
        </h2>
      </div>
      <p class="text-[0.65rem] uppercase tracking-[0.1em] text-muted">{journal.length} arsip esai</p>
    </div>

    {/* Featured Story */}
    <a class="group block mb-12" href={`/journal/${featured.slug}/`}>
      <div data-editable-img="journey-featured-img">
        <Media
          src={featured.image}
          alt={featured.imageAlt}
          aspect="16 / 9"
          widths={[640, 960, 1280, 1600]}
          sizes="100vw"
          priority
          parallax
          reveal
        />
      </div>

      <div class="mt-6 grid gap-6 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="text-[0.65rem] font-medium uppercase tracking-[0.13em] text-muted">
            {featured.category} / {featured.displayDate}
          </p>
          <h2 data-reveal-title class="mt-3 max-w-[20ch] font-display text-[clamp(2.4rem,4.8vw,4.5rem)] font-light leading-[0.98] tracking-[-0.02em] transition-colors duration-300 ease-luxe group-hover:text-accent">
            {featured.title}
          </h2>
        </div>
        <div class="lg:col-span-3 lg:col-start-10">
          <p class="max-w-[40ch] text-[0.95rem] leading-[1.7] text-muted">{featured.deck}</p>
          <p class="mt-4 text-[0.65rem] uppercase tracking-[0.1em] text-muted">
            {featured.readingTime}
          </p>
        </div>
      </div>
    </a>

    {/* Other Articles */}
    <div class="grid gap-12 lg:grid-cols-12 border-t border-line pt-8">
      {rest.map((post, index) => (
        <JournalCard
          post={post}
          aspect={index === 0 ? '3 / 2' : '3 / 4'}
          class:list={[
            index === 0 ? 'lg:col-span-6' : 'lg:col-span-4 lg:col-start-9',
          ]}
        />
      ))}
    </div>
  </Section>
</BaseLayout>
