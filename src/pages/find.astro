---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Media from '../components/ui/Media.astro';
import Button from '../components/ui/Button.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import Section from '../components/ui/Section.astro';
import DiscoverySet from '../components/DiscoverySet.astro';
import { fragrances, priceLabel } from '../data/fragrances';
import { images, alts } from '../data/images';
import { prisma } from '../../server/src/db';

export const prerender = false;

let dbElements: Record<string, string> = {};
let dbImages: Record<string, string> = {};

try {
  const page = await prisma.page.findFirst({
    where: { slug: 'find' },
    include: { sections: true },
  });
  if (page) {
    for (const sec of page.sections) {
      const c = (sec.contentData as any) || {};
      if (c.elements) dbElements = { ...dbElements, ...c.elements };
      if (c.images) dbImages = { ...dbImages, ...c.images };
    }
  }
} catch (e) {}

const getTxt = (id: string, fallback: string) => dbElements[id] || fallback;
const getImg = (id: string, fallback: string) => dbImages[id] || fallback;

const questions = [
  {
    id: 'q1',
    title: getTxt('find-q1-title', 'Suasana apa yang Anda cari?'),
    image: getImg('quiz-img-0', images.corridor),
    alt: alts.corridor,
    options: [
      {
        id: 'q1-opt1',
        label: getTxt('find-q1-opt1-label', 'Hangat dan tenang'),
        hint: getTxt('find-q1-opt1-hint', 'Seperti perpustakaan setelah tutup.'),
        scores: { 'oud-intime': 3, 'vetiver-obscura': 2, 'ambrette-12': 1 },
      },
      {
        id: 'q1-opt2',
        label: getTxt('find-q1-opt2-label', 'Segar dan hijau'),
        hint: getTxt('find-q1-opt2-hint', 'Seperti rumah kaca saat tengah hari.'),
        scores: { 'fig-nocturne': 3, 'iris-cendre': 2, 'vetiver-obscura': 1 },
      },
      {
        id: 'q1-opt3',
        label: getTxt('find-q1-opt3-label', 'Bersih dan asin'),
        hint: getTxt('find-q1-opt3-hint', 'Seperti pantai berbatu dan angin.'),
        scores: { 'sel-brut': 3, 'fig-nocturne': 1, 'ambrette-12': 1 },
      },
    ],
  },
  {
    id: 'q2',
    title: getTxt('find-q2-title', 'Material apa yang paling Anda sukai?'),
    image: getImg('quiz-img-1', images.atelier),
    alt: alts.atelier,
    options: [
      {
        id: 'q2-opt1',
        label: getTxt('find-q2-opt1-label', 'Akar dan asap'),
        hint: getTxt('find-q2-opt1-hint', 'Vetiver, oud, kayu.'),
        scores: { 'vetiver-obscura': 3, 'oud-intime': 2, 'fig-nocturne': 1 },
      },
      {
        id: 'q2-opt2',
        label: getTxt('find-q2-opt2-label', 'Bunga dan bedak'),
        hint: getTxt('find-q2-opt2-hint', 'Iris, violet, suede.'),
        scores: { 'iris-cendre': 3, 'ambrette-12': 2, 'oud-intime': 1 },
      },
      {
        id: 'q2-opt3',
        label: getTxt('find-q2-opt3-label', 'Garam dan getah'),
        hint: getTxt('find-q2-opt3-hint', 'Fig, citrus, udara laut.'),
        scores: { 'sel-brut': 3, 'fig-nocturne': 2, 'ambrette-12': 1 },
      },
    ],
  },
  {
    id: 'q3',
    title: getTxt('find-q3-title', 'Seberapa kuat jejak yang Anda inginkan?'),
    image: getImg('quiz-img-2', images.macroOud),
    alt: alts.macroOud,
    options: [
      {
        id: 'q3-opt1',
        label: getTxt('find-q3-opt1-label', 'Dekat di kulit'),
        hint: getTxt('find-q3-opt1-hint', 'Hanya tercium oleh Anda.'),
        scores: { 'ambrette-12': 3, 'iris-cendre': 2, 'sel-brut': 1 },
      },
      {
        id: 'q3-opt2',
        label: getTxt('find-q3-opt2-label', 'Sepanjang lengan'),
        hint: getTxt('find-q3-opt2-hint', 'Terasa saat orang mendekat.'),
        scores: { 'fig-nocturne': 3, 'sel-brut': 2, 'vetiver-obscura': 1 },
      },
      {
        id: 'q3-opt3',
        label: getTxt('find-q3-opt3-label', 'Memenuhi ruangan'),
        hint: getTxt('find-q3-opt3-hint', 'Jejak yang panjang dan berani.'),
        scores: { 'oud-intime': 3, 'vetiver-obscura': 2, 'iris-cendre': 1 },
      },
    ],
  },
];
---

<BaseLayout
  title="Find your scent"
  description="Jawab tiga pertanyaan singkat dan temukan parfum Omoo yang paling sesuai dengan selera Anda."
>
  <PageHeader
    deck={getTxt('find-deck', 'Tiga pertanyaan singkat tentang suasana, material, dan seberapa kuat parfum yang Anda inginkan. Kami akan menunjukkan satu komposisi yang paling dekat.')}
  >
    <Fragment slot="title">
      <span data-editable-id="find-title">{getTxt('find-title', 'Find your scent.')}</span>
    </Fragment>
  </PageHeader>

  <Section spacing="tight" class="pt-0">
    <div class="grid overflow-hidden border border-line lg:grid-cols-[5fr_7fr]">
      <div class="relative aspect-[4/3] min-h-0 lg:aspect-auto lg:min-h-[400px] lg:h-full" aria-hidden="true">
        {
          questions.map((question, index) => (
            <div
              class:list={[
                'absolute inset-0 transition-opacity duration-700 ease-luxe',
                index === 0 ? 'opacity-100' : 'opacity-0',
              ]}
              data-quiz-image={index}
              data-editable-img={`quiz-img-${index}`}
            >
              <Media src={question.image} alt="" fill class="h-full" sizes="40vw" />
            </div>
          ))
        }
      </div>

      <div class="bg-bg-tint p-6 md:p-10 lg:p-[clamp(2rem,4vw,4rem)]">
        <div data-quiz>
          <div class="flex flex-wrap items-center justify-between gap-4 border-b border-line pb-4">
            <p
              class="text-[0.65rem] font-medium uppercase tracking-[0.13em] text-muted"
              data-quiz-progress
              aria-live="polite"
            >
              Pertanyaan 1 dari 3
            </p>
            <div class="flex items-center gap-5">
              <button
                type="button"
                data-back
                hidden
                class="text-[0.65rem] font-medium uppercase tracking-[0.1em] text-muted transition-colors hover:text-ink"
              >
                Kembali
              </button>
              <button
                type="button"
                data-restart
                hidden
                class="text-[0.65rem] font-medium uppercase tracking-[0.1em] text-muted transition-colors hover:text-ink"
              >
                Mulai lagi
              </button>
            </div>
          </div>

          <div data-steps class="mt-8">
            {
              questions.map((question, index) => (
                <section
                  data-step
                  data-index={index}
                  hidden={index > 0}
                  aria-labelledby={`question-${index}`}
                >
                  <h2
                    id={`question-${index}`}
                    tabindex="-1"
                    class="max-w-[18ch] font-display text-[clamp(2rem,3.8vw,3.4rem)] font-light leading-[1] tracking-[-0.018em] outline-none"
                    data-editable-id={`find-q${index + 1}-title`}
                  >
                    {question.title}
                  </h2>

                  <div class="mt-8 grid" role="group" aria-labelledby={`question-${index}`}>
                    {question.options.map((option) => (
                      <button
                        type="button"
                        data-option
                        data-scores={JSON.stringify(option.scores)}
                        class="group flex items-center justify-between gap-6 border-t border-line py-5 text-left transition-colors duration-300 ease-luxe hover:text-accent"
                      >
                        <span class="flex flex-col gap-1.5 text-left">
                          <span
                            class="font-display text-[clamp(1.3rem,1.9vw,1.6rem)] font-light leading-tight"
                            data-editable-id={`find-${option.id}-label`}
                          >
                            {option.label}
                          </span>
                          <span
                            class="text-[0.7rem] leading-relaxed tracking-[0.01em] text-muted"
                            data-editable-id={`find-${option.id}-hint`}
                          >
                            {option.hint}
                          </span>
                        </span>
                        <span
                          aria-hidden="true"
                          class="flex-none text-[0.9rem] text-muted transition-all duration-300 ease-luxe group-hover:translate-x-1 group-hover:text-accent"
                        >
                          &#8594;
                        </span>
                      </button>
                    ))}
                  </div>
                </section>
              ))
            }
          </div>

          <div data-results hidden class="mt-8">
            <p class="text-[0.65rem] font-medium uppercase tracking-[0.13em] text-muted">Untuk Anda</p>

            {
              fragrances.map((fragrance) => (
                <article data-result={fragrance.slug} hidden class="mt-5">
                  <div class="grid grid-cols-[6.5rem_1fr] gap-4 sm:grid-cols-[150px_1fr] sm:gap-7">
                    <Media
                      src={fragrance.bottle}
                      alt={fragrance.bottleAlt}
                      aspect="4 / 5"
                      widths={[200, 300, 420]}
                      sizes="(max-width: 640px) 104px, 150px"
                    />

                    <div>
                      <p class="text-[0.62rem] font-medium uppercase tracking-[0.13em] text-muted">
                        {fragrance.edition} / {fragrance.family}
                      </p>
                      <h2
                        tabindex="-1"
                        class="mt-1.5 font-display text-[1.6rem] font-light leading-[0.95] tracking-[-0.02em] outline-none sm:text-[clamp(2rem,3.4vw,3.2rem)]"
                      >
                        {fragrance.name}
                      </h2>
                      <p class="mt-2 font-display text-[1rem] font-light italic leading-snug sm:mt-3 sm:text-[1.25rem]">
                        {fragrance.tagline}
                      </p>
                      <p class="mt-4 hidden max-w-[44ch] text-[0.9rem] leading-[1.65] text-muted sm:block">
                        {fragrance.description}
                      </p>
                      <p class="mt-4 hidden text-[0.7rem] uppercase leading-[1.7] tracking-[0.06em] text-muted sm:block">
                        {[...fragrance.notes.top, ...fragrance.notes.heart, ...fragrance.notes.base].join(' / ')}
                      </p>
                      <div class="mt-4 flex flex-wrap items-center gap-4 sm:mt-5">
                        <Button
                          href={`/collection/${fragrance.slug}/`}
                          size="small"
                          ariaLabel={`Lihat parfum ${fragrance.name}`}
                        >
                          Lihat parfum
                        </Button>
                        <span class="text-[0.8rem] text-muted">{priceLabel(fragrance.price)}</span>
                      </div>
                    </div>
                  </div>
                </article>
              ))
            }

            <p class="mt-8 border-t border-line pt-5 text-[0.8rem] leading-relaxed text-muted">
              Belum tepat? Seluruh koleksi ada di
              <a class="underline underline-offset-4 transition-colors hover:text-ink" href="/collection/">
                halaman koleksi
              </a>.
            </p>
          </div>

          <noscript>
            <p class="mt-6 border-t border-line pt-5 text-[0.85rem] leading-relaxed text-muted">
              Finder membutuhkan JavaScript. Anda tetap bisa menjelajahi
              <a class="underline underline-offset-4" href="/collection/">seluruh koleksi</a>.
            </p>
          </noscript>
        </div>
      </div>
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-[0.7rem] uppercase tracking-[0.08em] text-muted">
      <span>Lebih suka membaca?</span>
      <ArrowLink href="/collection/">Lihat semua parfum</ArrowLink>
    </div>
  </Section>

  <DiscoverySet />
</BaseLayout>

<script>
  const quiz = document.querySelector<HTMLElement>('[data-quiz]');
  const steps = Array.from(document.querySelectorAll<HTMLElement>('[data-step]'));
  const images = Array.from(document.querySelectorAll<HTMLElement>('[data-quiz-image]'));
  const results = document.querySelector<HTMLElement>('[data-results]');
  const resultCards = Array.from(document.querySelectorAll<HTMLElement>('[data-result]'));
  const stepsWrap = document.querySelector<HTMLElement>('[data-steps]');
  const progress = document.querySelector<HTMLElement>('[data-quiz-progress]');
  const back = document.querySelector<HTMLButtonElement>('[data-back]');
  const restart = document.querySelector<HTMLButtonElement>('[data-restart]');
  const priority = ['vetiver-obscura', 'iris-cendre', 'fig-nocturne', 'sel-brut', 'oud-intime', 'ambrette-12'];

  let index = 0;
  const answers: Record<string, number>[] = [];

  const showStep = (next: number, focus = false) => {
    index = next;
    steps.forEach((step, stepIndex) => {
      step.hidden = stepIndex !== next;
    });
    images.forEach((image, imageIndex) => {
      const active = imageIndex === next;
      image.classList.toggle('opacity-100', active);
      image.classList.toggle('opacity-0', !active);
    });
    if (progress) progress.textContent = `Pertanyaan ${next + 1} dari 3`;
    if (back) back.hidden = next === 0;
    if (restart) restart.hidden = next === 0;
    if (focus) {
      const heading = steps[next]?.querySelector<HTMLElement>('h2');
      heading?.focus({ preventScroll: true });
    }
  };

  const finish = () => {
    const totals: Record<string, number> = {};
    answers.forEach((answer) => {
      Object.entries(answer).forEach(([slug, points]) => {
        totals[slug] = (totals[slug] ?? 0) + points;
      });
    });

    const highest = Math.max(...Object.values(totals));
    let candidates = priority.filter((slug) => (totals[slug] ?? 0) === highest);

    [...answers].reverse().forEach((answer) => {
      if (candidates.length === 1) return;
      const best = Math.max(...candidates.map((slug) => answer[slug] ?? 0));
      candidates = candidates.filter((slug) => (answer[slug] ?? 0) === best);
    });

    const winner = candidates[0];
    if (stepsWrap) stepsWrap.hidden = true;
    if (results) results.hidden = false;
    resultCards.forEach((card) => {
      card.hidden = card.dataset.result !== winner;
    });
    if (progress) progress.textContent = 'Hasil Anda';
    if (back) back.hidden = true;
    if (restart) restart.hidden = false;

    const heading = resultCards
      .find((card) => card.dataset.result === winner)
      ?.querySelector<HTMLElement>('h2');
    heading?.focus({ preventScroll: true });
  };

  const reset = () => {
    answers.length = 0;
    if (stepsWrap) stepsWrap.hidden = false;
    if (results) results.hidden = true;
    resultCards.forEach((card) => {
      card.hidden = true;
    });
    showStep(0, true);
  };

  quiz?.querySelectorAll<HTMLButtonElement>('[data-option]').forEach((option) => {
    option.addEventListener('click', () => {
      try {
        answers[index] = JSON.parse(option.dataset.scores ?? '{}');
      } catch {
        answers[index] = {};
      }
      if (index < steps.length - 1) {
        showStep(index + 1, true);
      } else {
        finish();
      }
    });
  });

  back?.addEventListener('click', () => {
    if (index > 0) showStep(index - 1, true);
  });

  restart?.addEventListener('click', reset);
</script>
