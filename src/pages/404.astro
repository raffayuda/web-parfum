---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
---

<BaseLayout
  title="Page not found"
  description="This page has evaporated. Return to the Omoo collection or the atelier."
  noindex
>
  <section class="flex min-h-[62vh] items-center py-section">
    <div class="mx-auto w-full max-w-page px-gutter">
      <p class="font-display text-[clamp(6rem,22vw,19rem)] font-light leading-[0.7] tracking-[-0.04em] text-muted/60">
        404
      </p>
      <h1 class="mt-6 max-w-[14ch] font-display text-[clamp(2.4rem,5vw,4.5rem)] font-light leading-[0.98] tracking-[-0.02em]">
        This page has evaporated.
      </h1>
      <p class="mt-5 max-w-[42ch] text-[0.95rem] leading-[1.7] text-muted">
        The link may be old, or the composition may have been replaced. The collection is the best
        place to begin again.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-6">
        <ArrowLink href="/">Return home</ArrowLink>
        <ArrowLink href="/collection/">View all fragrances</ArrowLink>
      </div>
    </div>
  </section>
</BaseLayout>
