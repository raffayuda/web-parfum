---

import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
import ArrowLink from '../../components/ui/ArrowLink.astro';
import Media from '../../components/ui/Media.astro';
import Section from '../../components/ui/Section.astro';
import FragranceCard from '../../components/FragranceCard.astro';
import { bySlug, fragrances, priceLabel } from '../../data/fragrances';
import { resolvePublicImageUrl } from '../../data/images';
import { whatsappHref } from '../../data/site';
import { prisma } from '../../../server/src/db';
import { ProductOrderActions } from '../../components/checkout/ProductOrderActions';
import { ProductGalleryViewer, type ProductGalleryImageItem } from '../../components/collection/ProductGalleryViewer';

export const prerender = false;

const { slug } = Astro.params;

let dbFrag: any = null;
const normalizedSlug = (slug as string).replace(/_/g, '-');
try {
  dbFrag = await prisma.fragrance.findFirst({
    where: {
      OR: [
        { slug: slug as string },
        { slug: normalizedSlug },
        { id: slug as string },
      ],
    },
  });
} catch (e) {}

const staticFrag = bySlug(slug as string) || bySlug(normalizedSlug);
if (!dbFrag && !staticFrag) {
  return Astro.redirect('/collection');
}

const rawQuote = dbFrag?.quote || staticFrag?.quote;
const quote = (typeof rawQuote === 'object' && rawQuote?.text)
  ? rawQuote
  : {
      text: 'Wewangian murni yang menyatu harmonis dengan karakter pemakainya.',
      attribution: 'Camille Aumont, Perfumer',
    };

const rawPerf = dbFrag?.performance || staticFrag?.performance;
const performance = (typeof rawPerf === 'object' && rawPerf?.concentration)
  ? rawPerf
  : {
      concentration: 'Extrait de parfum, 20%',
      maceration: 'Enam minggu',
      longevity: '8 sampai 10 jam',
      sillage: 'Sejauh lengan',
    };

const fragrance = {
  ...(staticFrag || {}),
  ...(dbFrag || {}),
  price: dbFrag ? Number(dbFrag.price) : staticFrag?.price,
  bottle: resolvePublicImageUrl(dbFrag?.bottleImage || staticFrag?.bottle),
  card: resolvePublicImageUrl(dbFrag?.bottleImage || staticFrag?.card),
  macro: resolvePublicImageUrl(dbFrag?.macroImage || staticFrag?.macro, '/images/products/emerald-box.webp'),
  notes: dbFrag?.notes ? (dbFrag.notes as any) : (staticFrag?.notes || { top: [], heart: [], base: [] }),
  material: dbFrag?.material ? (dbFrag.material as any) : (staticFrag?.material || { name: 'Raw Material', origin: 'Grasse', phrase: 'Murni dari alam' }),
  story: dbFrag?.story
    ? (Array.isArray(dbFrag.story) ? dbFrag.story : [String(dbFrag.story)])
    : (staticFrag?.story || []),
  quote,
  performance,
  isAvailable: dbFrag ? dbFrag.isAvailable : (staticFrag?.isAvailable ?? true),
  related: dbFrag?.relatedSlugs?.length ? dbFrag.relatedSlugs : (staticFrag?.related || []),
};

// Build multi-image gallery list from DB galleryImages + bottleImage + macroImage (deduplicated)
const rawGallery: ProductGalleryImageItem[] = [];
const pushUniqueImage = (url?: string | null, alt?: string, label?: string) => {
  if (!url) return;
  const resolved = resolvePublicImageUrl(url);
  if (!resolved || rawGallery.some((item) => item.url === resolved)) return;
  rawGallery.push({ url: resolved, alt: alt || fragrance.name, label });
};

pushUniqueImage(fragrance.bottle, fragrance.bottleAlt || fragrance.name, 'Foto Utama');
if (Array.isArray(dbFrag?.galleryImages)) {
  for (const g of dbFrag.galleryImages as any[]) {
    if (g?.url) pushUniqueImage(g.url, g.alt || fragrance.name, g.label);
  }
} else if (Array.isArray(staticFrag?.galleryImages)) {
  for (const g of staticFrag.galleryImages) {
    pushUniqueImage(typeof g.url === 'string' ? g.url : '', g.alt || fragrance.name, g.label);
  }
}
pushUniqueImage(fragrance.macro, fragrance.macroAlt || `Kemasan ${fragrance.name}`, 'Kemasan Box');
const productGallery = rawGallery;
const isAvailable = fragrance.isAvailable;
const related = fragrance.related.map((slug: string) => bySlug(slug) || (fragrances.find(f => f.slug === slug))).filter(Boolean);
const productWhatsapp = whatsappHref(
  `Halo OMOO, saya ingin memesan ${fragrance.name} (${fragrance.volume}, ${priceLabel(fragrance.price)}). Mohon info ketersediaan dan pengiriman.`
);
const notes = [
  { label: 'Top', items: fragrance.notes.top },
  { label: 'Heart', items: fragrance.notes.heart },
  { label: 'Base', items: fragrance.notes.base },
];
const details = [
  { label: 'Material', value: fragrance.material.name },
  { label: 'Origin', value: fragrance.material.origin },
  { label: 'Family', value: fragrance.family },
  { label: 'Concentration', value: fragrance.performance.concentration },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: fragrance.name,
  description: fragrance.description,
  brand: { '@type': 'Brand', name: 'Omoo' },
  sku: fragrance.edition,
  offers: {
    '@type': 'Offer',
    price: fragrance.price,
    priceCurrency: 'IDR',
    availability: 'https://schema.org/InStock',
    url: `https://omoo.studio/collection/${fragrance.slug}/`,
  },
};
---

<BaseLayout title={fragrance.name} description={fragrance.description} ogType="product" schema={schema}>
  <div class="mx-auto w-full max-w-page px-gutter pt-6">
    <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-[0.65rem] uppercase tracking-[0.1em] text-muted">
      <a href="/collection/" class="transition-colors hover:text-ink">Collection</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{fragrance.name}</span>
    </nav>
  </div>

  <section class="pb-section-tight pt-8 md:pt-10">
    <div class="mx-auto grid w-full max-w-page gap-10 px-gutter md:grid-cols-12 md:gap-gutter">
      <div class="relative md:col-span-6 space-y-6">
        <ProductGalleryViewer
          client:load
          images={productGallery}
          productName={fragrance.name}
        />

        <div class="flex flex-col justify-between border-t border-line pt-4">
          <p class="text-[0.58rem] font-medium uppercase tracking-[0.12em] text-muted">Material &amp; Inspirasi</p>
          <p class="mt-2 font-display text-[clamp(1.4rem,2vw,1.9rem)] font-light italic leading-[1.15]">
            {fragrance.material.phrase}
          </p>
          <p class="mt-2 text-[0.65rem] uppercase tracking-[0.1em] text-muted">
            {fragrance.material.name}, {fragrance.material.origin}
          </p>
        </div>
      </div>

      <div class="md:col-span-5 md:col-start-8 md:pt-4">
        <p class="text-[0.65rem] font-medium uppercase tracking-[0.13em] text-muted">
          {fragrance.edition} / {fragrance.family}
        </p>

        <h1 data-page-title class="mt-4 font-display text-[clamp(3rem,5.8vw,5.6rem)] font-light leading-[0.92] tracking-[-0.022em] text-balance">
          {fragrance.name}
        </h1>

        <p data-page-deck class="mt-5 font-display text-[clamp(1.4rem,2vw,1.8rem)] font-light italic leading-snug">
          {fragrance.tagline}
        </p>

        <p class="mt-6 max-w-[44ch] text-[0.95rem] leading-[1.7] text-muted">
          {fragrance.description}
        </p>

        <div class="mt-8 flex items-baseline justify-between gap-6 border-y border-line py-4">
          <span class="font-display text-3xl">{priceLabel(fragrance.price)}</span>
          <span class="text-[0.7rem] uppercase tracking-[0.08em] text-muted">
            {fragrance.volume} / Eau de Parfum
          </span>
        </div>

        <dl class="grid grid-cols-2 gap-x-6 gap-y-5 py-6">
          {
            details.map((detail) => (
              <div class="grid gap-1">
                <dt class="text-[0.62rem] uppercase tracking-[0.12em] text-muted">{detail.label}</dt>
                <dd class="text-[0.9rem] leading-snug">{detail.value}</dd>
              </div>
            ))
          }
        </dl>

        <div class="flex flex-col items-start gap-4">
          <ProductOrderActions
            client:load
            product={{
              id: fragrance.id,
              slug: fragrance.slug,
              name: fragrance.name,
              volume: fragrance.volume,
              price: fragrance.price,
              edition: fragrance.edition,
              bottleImage: fragrance.bottle,
              isAvailable,
            }}
            whatsappUrl={productWhatsapp}
          />
          <ArrowLink href="/find/">Find your scent</ArrowLink>
        </div>

        <p class="mt-5 max-w-[40ch] text-[0.72rem] leading-relaxed text-muted">
          Pemesanan, pembayaran, dan pengiriman diatur lewat WhatsApp. Kami mengirim ke seluruh Indonesia.
        </p>
      </div>
    </div>
  </section>

  <Section tone="surface">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-3">
        <h2 data-reveal-title class="pb-1 font-display text-[clamp(2.35rem,4.2vw,4rem)] font-light leading-[0.98] tracking-[-0.02em]">
          Composition.
        </h2>
        <p class="mt-2 text-[0.65rem] uppercase tracking-[0.14em] text-muted">
          Piramida Struktur Aroma
        </p>
      </div>

      <div class="lg:col-span-8 lg:col-start-5">
        <div class="grid gap-8 sm:grid-cols-3">
          {
            notes.map((group) => (
              <div data-reveal class="border-t border-line pt-4">
                <h3 class="text-[0.62rem] font-medium uppercase tracking-[0.14em] text-muted">
                  {group.label}
                </h3>
                <ul class="mt-4 grid gap-2">
                  {group.items.map((note: string) => (
                    <li class="font-display text-[clamp(1.25rem,1.8vw,1.55rem)] font-light leading-tight">
                      {note}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </Section>

  {fragrance.quote?.text && (
    <section class="py-section-tight">
      <div class="mx-auto w-full max-w-page px-gutter">
        <figure data-reveal class="grid gap-6 border-t border-line pt-8 lg:grid-cols-12">
          <blockquote class="lg:col-span-8">
            <p class="font-display text-[clamp(1.9rem,3.6vw,3.4rem)] font-light leading-[1.04] tracking-[-0.015em]">
              &ldquo;{fragrance.quote.text}&rdquo;
            </p>
          </blockquote>
          {fragrance.quote.attribution && (
            <figcaption class="self-end text-[0.65rem] font-medium uppercase leading-[1.6] tracking-[0.12em] text-muted lg:col-span-3 lg:col-start-10">
              {fragrance.quote.attribution}
            </figcaption>
          )}
        </figure>
      </div>
    </section>
  )}

  <Section spacing="tight">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-3">
        <h2 data-reveal-title class="pb-1 font-display text-[clamp(2.35rem,4.2vw,4rem)] font-light leading-[0.98] tracking-[-0.02em]">
          On skin.
        </h2>
      </div>

      <dl class="grid grid-cols-2 gap-x-8 lg:col-span-8 lg:col-start-5">
        {
          [
            ['Concentration', fragrance.performance.concentration],
            ['Maceration', fragrance.performance.maceration],
            ['Longevity', fragrance.performance.longevity],
            ['Sillage', fragrance.performance.sillage],
          ].map(([label, value]) => (
            <div data-reveal class="border-t border-line py-6 md:py-8">
              <dt class="text-[0.62rem] uppercase tracking-[0.12em] text-muted">{label}</dt>
              <dd class="mt-3 font-display text-[clamp(1.65rem,2.4vw,2.5rem)] font-light leading-[1.05]">
                {value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>

  <Section>
    <div class="grid gap-12 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-3">
        <h2
          data-reveal-title
          class="max-w-[8ch] pb-1 font-display text-[clamp(2.35rem,4.2vw,4rem)] font-light leading-[0.98] tracking-[-0.02em]"
        >
          Wear it with
        </h2>
        <p data-reveal class="mt-5 max-w-[28ch] text-[0.9rem] leading-[1.65] text-muted">
          Dua komposisi yang duduk dekat dengan yang ini.
        </p>
      </div>

      <div class="grid gap-10 sm:grid-cols-2 lg:col-span-8 lg:col-start-5">
        {
          related.map((item: any) => (
            <div data-reveal>
              <FragranceCard fragrance={item} aspect="4 / 5" />
            </div>
          ))
        }
      </div>
    </div>
  </Section>
</BaseLayout>
