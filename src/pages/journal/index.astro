---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Media from '../../components/ui/Media.astro';
import Section from '../../components/ui/Section.astro';
import JournalCard from '../../components/JournalCard.astro';
import { journal } from '../../data/journal';

const [featured, ...rest] = journal;
---

<BaseLayout
  title="Journal"
  description="Essays, material notes and reports from the Omoo atelier in Paris."
>
  <PageHeader deck="Essays, material notes and reports from the quiet parts of the atelier.">
    <Fragment slot="title">The <span class="italic">journal</span>.</Fragment>
  </PageHeader>

  <Section spacing="tight" class="pt-0">
    <a class="group block" href={`/journal/${featured.slug}/`}>
      <Media
        src={featured.image}
        alt={featured.imageAlt}
        aspect="16 / 9"
        widths={[640, 960, 1280, 1600]}
        sizes="100vw"
        priority
        parallax
        reveal
      />

      <div class="mt-6 grid gap-6 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="text-[0.65rem] font-medium uppercase tracking-[0.13em] text-muted">
            {featured.category} / {featured.displayDate}
          </p>
          <h2 data-reveal-title class="mt-3 max-w-[20ch] font-display text-[clamp(2.4rem,4.8vw,4.5rem)] font-light leading-[0.98] tracking-[-0.02em] transition-colors duration-300 ease-luxe group-hover:text-accent">
            {featured.title}
          </h2>
        </div>
        <div class="lg:col-span-3 lg:col-start-10">
          <p class="max-w-[40ch] text-[0.95rem] leading-[1.7] text-muted">{featured.deck}</p>
          <p class="mt-4 text-[0.65rem] uppercase tracking-[0.1em] text-muted">
            {featured.readingTime}
          </p>
        </div>
      </div>
    </a>
  </Section>

  <Section spacing="tight">
    <div class="mb-10 flex items-baseline justify-between gap-6 border-t border-line pt-4">
      <h2 class="font-display text-2xl font-light">More writing</h2>
      <p class="text-[0.65rem] uppercase tracking-[0.1em] text-muted">{rest.length} pieces</p>
    </div>

    <div class="grid gap-12 lg:grid-cols-12">
      {
        rest.map((post, index) => (
          <JournalCard
            post={post}
            aspect={index === 0 ? '3 / 2' : '3 / 4'}
            class:list={[
              index === 0 ? 'lg:col-span-6' : 'lg:col-span-4 lg:col-start-9',
            ]}
          />
        ))
      }
    </div>
  </Section>
</BaseLayout>
