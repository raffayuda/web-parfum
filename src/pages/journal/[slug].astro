---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArrowLink from '../../components/ui/ArrowLink.astro';
import Media from '../../components/ui/Media.astro';
import Section from '../../components/ui/Section.astro';
import JournalCard from '../../components/JournalCard.astro';
import { journal } from '../../data/journal';

export const prerender = true;

export function getStaticPaths() {
  return journal.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { slug } = Astro.params;
const post = Astro.props.post || journal.find((item) => item.slug === slug);
if (!post) {
  return Astro.redirect('/journal');
}
const currentIndex = journal.findIndex((item) => item.slug === post.slug);
const next = journal[(currentIndex + 1) % journal.length];
const related = journal.filter((item) => item.slug !== post.slug).slice(0, 2);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.deck,
  datePublished: post.date,
  author: { '@type': 'Person', name: 'Camille Aumont' },
  publisher: { '@type': 'Organization', name: 'Omoo' },
  mainEntityOfPage: `https://omoo.studio/journal/${post.slug}/`,
};
---

<BaseLayout title={post.title} description={post.deck} ogType="article" schema={schema}>
  <div class="mx-auto w-full max-w-page px-gutter pt-6">
    <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-[0.65rem] uppercase tracking-[0.1em] text-muted">
      <a href="/journal/" class="transition-colors hover:text-ink">Journal</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{post.category}</span>
    </nav>
  </div>

  <header class="mx-auto w-full max-w-page px-gutter pb-10 pt-[clamp(3rem,6vw,5.5rem)]">
    <p class="text-[0.65rem] font-medium uppercase tracking-[0.13em] text-muted">
      {post.category} / {post.displayDate} / {post.readingTime}
    </p>
    <h1 data-page-title class="mt-5 max-w-[17ch] font-display text-[clamp(3rem,7vw,6.5rem)] font-light leading-[0.94] tracking-[-0.022em] text-balance">
      {post.title}
    </h1>
    <p data-page-deck class="mt-6 max-w-[46ch] text-[clamp(1.05rem,1.4vw,1.25rem)] leading-[1.6] text-muted">
      {post.deck}
    </p>
  </header>

  <div class="mx-auto w-full max-w-page px-gutter">
    <Media
      src={post.image}
      alt={post.imageAlt}
      aspect="16 / 9"
      widths={[640, 960, 1280, 1600]}
      sizes="100vw"
      priority
      quality={85}
      parallax
      reveal
    />
  </div>

  <Section spacing="tight">
    <div class="grid gap-10 lg:grid-cols-12">
      <aside class="lg:col-span-2 lg:sticky lg:top-28 lg:self-start">
        <p class="text-[0.62rem] font-medium uppercase leading-[1.7] tracking-[0.12em] text-muted">
          {post.category}<br />
          {post.displayDate}<br />
          {post.readingTime}
        </p>
      </aside>

      <article class="lg:col-span-7 lg:col-start-4">
        {
          post.body.map((block, index) => {
            if (block.type === 'h2') {
              return (
                <h2 data-reveal class="mb-5 mt-12 font-display text-[clamp(1.9rem,3vw,2.7rem)] font-light leading-[1.05] first:mt-0">
                  {block.text}
                </h2>
              );
            }
            if (block.type === 'quote') {
              return (
                <blockquote data-reveal class="my-12 border-l border-accent pl-6">
                  <p class="font-display text-[clamp(1.7rem,2.8vw,2.5rem)] font-light italic leading-[1.15]">
                    &ldquo;{block.text}&rdquo;
                  </p>
                  {block.attribution && (
                    <footer class="mt-3 text-[0.65rem] uppercase tracking-[0.1em] text-muted">
                      {block.attribution}
                    </footer>
                  )}
                </blockquote>
              );
            }
            return (
              <p
                class:list={[
                  'mb-6 max-w-[68ch] text-[0.98rem] leading-[1.8] text-muted',
                  index === 0 &&
                    'first-letter:float-left first-letter:pr-2 first-letter:font-display first-letter:text-[4.4rem] first-letter:leading-[0.8] first-letter:text-ink',
                ]}
              >
                {block.text}
              </p>
            );
          })
        }

        <div class="mt-12 flex flex-wrap items-center gap-6 border-t border-line pt-6">
          <ArrowLink href="/journal/">All writing</ArrowLink>
          <ArrowLink href={`/journal/${next.slug}/`}>Berikutnya: {next.title}</ArrowLink>
        </div>
      </article>
    </div>
  </Section>

  <Section>
    <div class="mb-10 flex items-baseline justify-between gap-6 border-t border-line pt-4">
      <h2 class="font-display text-2xl font-light">Baca juga</h2>
    </div>
    <div class="grid gap-12 lg:grid-cols-12">
      {
        related.map((item, index) => (
          <JournalCard
            post={item}
            aspect={index === 0 ? '3 / 2' : '3 / 4'}
            class:list={[
              index === 0 ? 'lg:col-span-6' : 'lg:col-span-4 lg:col-start-9',
            ]}
          />
        ))
      }
    </div>
  </Section>
</BaseLayout>
