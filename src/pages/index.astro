---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Media from '../components/ui/Media.astro';
import Section from '../components/ui/Section.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import FragranceCard from '../components/FragranceCard.astro';
import JournalCard from '../components/JournalCard.astro';
import DiscoverySet from '../components/DiscoverySet.astro';
import { featured, materials, priceLabel } from '../data/fragrances';
import { journal } from '../data/journal';
import { site } from '../data/site';
import { images, alts } from '../data/images';
import { prisma } from '../../server/src/db';
import { InlineVisualEditor } from '../components/admin/InlineVisualEditor';

let dbSections: any[] = [];
let pageId: string | undefined = undefined;
let dbPerfumes: any[] = [];
let hiddenSections: string[] = [];

try {
  const page = await prisma.page.findUnique({
    where: { slug: 'home' },
    include: {
      sections: {
        orderBy: { order: 'asc' },
      },
    },
  });
  if (page) {
    dbSections = page.sections;
    pageId = page.id;
    for (const s of page.sections) {
      const c = (s.contentData as any) || {};
      if (Array.isArray(c.hiddenSections)) {
        hiddenSections = [...hiddenSections, ...c.hiddenSections];
      }
    }
  }

  dbPerfumes = await prisma.fragrance.findMany({ orderBy: { edition: 'asc' } });
} catch (e) {
  // Graceful fallback to static if db is temporarily offline
}

// Find dynamic sections:
const heroSec = dbSections.find((s) => s.template === 'HERO_EDITORIAL');
const showcaseSec = dbSections.find((s) => s.template === 'FRAGRANCE_GRID');
const materialSec = dbSections.find((s) => s.template === 'MATERIAL_STORY');
const quizSec = dbSections.find((s) => s.template === 'RICH_TEXT_MEDIA');
const quoteSec = dbSections.find((s) => s.template === 'HERO_SPLIT');
const processSec = dbSections.find((s) => s.template === 'PROCESS_STEPS');
const halalSec = dbSections.find((s) => s.template === 'HALAL_BPOM_BADGE');
const discoverySec = dbSections.find((s) => s.template === 'DISCOVERY_BANNER');

// Section visibility: permanently respected from database. If deleted or hidden, NEVER reappear!
const showHero = !hiddenSections.includes('HERO_EDITORIAL') && (heroSec ? heroSec.isActive : dbSections.length === 0);
const showShowcase = !hiddenSections.includes('FRAGRANCE_GRID') && (showcaseSec ? showcaseSec.isActive : dbSections.length === 0);
const showMaterials = !hiddenSections.includes('MATERIAL_STORY') && (materialSec ? materialSec.isActive : dbSections.length === 0);
const showQuiz = !hiddenSections.includes('RICH_TEXT_MEDIA') && (quizSec ? quizSec.isActive : dbSections.length === 0);
const showQuote = !hiddenSections.includes('HERO_SPLIT') && (quoteSec ? quoteSec.isActive : dbSections.length === 0);
const showProcess = !hiddenSections.includes('PROCESS_STEPS') && (processSec ? processSec.isActive : dbSections.length === 0);
const showHalal = !hiddenSections.includes('HALAL_BPOM_BADGE') && (halalSec ? halalSec.isActive : dbSections.length === 0);
const showDiscovery = !hiddenSections.includes('DISCOVERY_BANNER') && (discoverySec ? discoverySec.isActive : dbSections.length === 0);

// 1. Hero Section texts
const heroEyebrow = heroSec?.eyebrow || 'Maison de parfum, Jakarta';
const heroTitle = heroSec?.title || 'Wear what cannot be seen.';
const heroSubtitle =
  heroSec?.subtitle ||
  'Enam komposisi dengan material pilihan, diracik perlahan di Jakarta. Tinggal di kulit, lebih lama dari yang Anda kira.';
const heroCtaText = heroSec?.contentData?.ctaText || 'Explore the collection';
const heroCtaLink = heroSec?.contentData?.ctaLink || '/collection/';
const heroSecondaryText = heroSec?.contentData?.secondaryText || 'Find your scent';
const heroSecondaryLink = heroSec?.contentData?.secondaryLink || '/find/';

// 2. Showcase Catalog Section texts
const showcaseEyebrow = showcaseSec?.eyebrow || 'Six compositions.';
const showcaseTitle = showcaseSec?.title || 'Satu material, satu arah.';
const showcaseSubtitle = showcaseSec?.subtitle || 'View all fragrances';
const showcaseFooterQuote =
  showcaseSec?.contentData?.footerQuote ||
  'The collection stays at six. Komposisi baru menggantikan yang lama, tidak pernah menumpuk di sampingnya.';

// Enrich Perfumes dynamically from DB
const enrichedFromDb = dbPerfumes.map((dbFrag) => {
  const staticFrag = featured.find((f) => f.slug === dbFrag.slug) || featured[0];
  const dbNotes = (dbFrag.notes as any) || staticFrag.notes;
  return {
    ...staticFrag,
    ...dbFrag,
    price: Number(dbFrag.price),
    notes: dbNotes,
    bottle: dbFrag.bottleImage || dbFrag.bottle || staticFrag.bottle,
    bottleAlt: dbFrag.bottleAlt || staticFrag.bottleAlt,
    macro: dbFrag.macroImage || dbFrag.macro || staticFrag.macro,
    macroAlt: dbFrag.macroAlt || staticFrag.macroAlt,
    card: dbFrag.bottleImage || dbFrag.card || staticFrag.card,
    cardAlt: dbFrag.cardAlt || staticFrag.cardAlt,
    isAvailable: dbFrag.isAvailable,
  };
});

const [lead, ...secondary] = enrichedFromDb.length > 0 ? enrichedFromDb : featured;
const enrichedLead = lead;
const enrichedSecondary = secondary;

const leadNotes = [
  { label: 'Top', notes: enrichedLead.notes.top },
  { label: 'Heart', notes: enrichedLead.notes.heart },
  { label: 'Base', notes: enrichedLead.notes.base },
];

// 3. Materials Section texts
const materialTitle = materialSec?.title || 'Materials, satu per satu.';
const materialSubtitle =
  materialSec?.subtitle ||
  'Setiap komposisi dimulai dari satu material dan tempat asalnya. Arahkan kursor ke nama untuk melihatnya.';

// 4. Quiz Consultation texts
const quizTitle = quizSec?.title || 'Tiga pertanyaan.';
const quizSubtitle = quizSec?.subtitle || 'Satu parfum.';
const quizDesc =
  quizSec?.contentData?.description ||
  'Tiga pertanyaan singkat tentang suasana, material favorit, dan seberapa kuat parfum yang Anda inginkan.';
const quizItemRoom = quizSec?.contentData?.itemRoom || 'Suasana yang Anda cari';
const quizItemMaterial = quizSec?.contentData?.itemMaterial || 'Bahan yang Anda sukai';
const quizItemTrace = quizSec?.contentData?.itemTrace || 'Kekuatan parfumnya';
const quizCtaText = quizSec?.contentData?.ctaText || 'Find your scent';
const quizCtaLink = quizSec?.contentData?.ctaLink || '/find/';

// 5. Quote Section texts
const quoteText =
  quoteSec?.title ||
  'The house is small on purpose. Hanya dengan begitu saya bisa mencium setiap batch sebelum ia meninggalkan atelier.';
const quoteAuthor = quoteSec?.subtitle || 'Camille Aumont';
const quoteRole = quoteSec?.contentData?.authorRole || 'Founder and perfumer';
const quoteCtaText = quoteSec?.contentData?.ctaText || 'Inside the maison';
const quoteCtaLink = quoteSec?.contentData?.ctaLink || '/about/';

// 6. Process Section texts
const processTitle = processSec?.title || 'Slow is a material.';
const processSubtitle =
  processSec?.subtitle ||
  'Tidak ada yang selesai karena jadwal. Formula yang menentukan kapan ia siap.';
const step1Title = processSec?.contentData?.step1Title || 'Compose';
const step1Copy =
  processSec?.contentData?.step1Copy ||
  'Satu material memimpin. Catatan lain ditulis mengelilinginya, tidak pernah menutupinya.';
const step2Title = processSec?.contentData?.step2Title || 'Macerate';
const step2Copy =
  processSec?.contentData?.step2Copy ||
  'Konsentrat beristirahat di baja, lalu kaca. Minggu-minggu berlalu dan tepinya melembut.';
const step3Title = processSec?.contentData?.step3Title || 'Bottle';
const step3Copy =
  processSec?.contentData?.step3Copy ||
  'Setiap flacon diisi, disegel, dan diberi nomor di atelier Jakarta.';

const process = [
  {
    title: step1Title,
    copy: step1Copy,
    image: images.atelier,
    alt: alts.atelier,
  },
  {
    title: step2Title,
    copy: step2Copy,
    image: images.maceration,
    alt: alts.maceration,
  },
  {
    title: step3Title,
    copy: step3Copy,
    image: images.bottleOud,
    alt: alts.bottleOud,
  },
];

// 7. Halal & BPOM texts
const halalEyebrow = halalSec?.eyebrow || 'Legality & Trust';
const halalTitle = halalSec?.title || 'Sertifikasi Resmi BPOM & Halal';
const halalSubtitle =
  halalSec?.subtitle ||
  'Seluruh formula wewangian OMOO telah teruji di laboratorium terakreditasi, resmi terdaftar di BPOM RI, dan bersertifikat Halal Indonesia.';
const halalCtaText = halalSec?.contentData?.ctaText || 'Verifikasi Google Lens';
const halalCode = halalSec?.contentData?.featuredCode || 'BPOM-OM01-VETIVER';
const halalNotice = halalSec?.contentData?.scanNotice || 'Pindai QR dus atau buka lembar sertifikat';

// 8. Discovery Set texts
const discoveryTitle = discoverySec?.title || 'Discovery Set (6 x 2 ml)';
const discoverySubtitle =
  discoverySec?.subtitle ||
  'Kenali seluruh keenam wewangian di kulit Anda sebelum memilih satu flacon penuh. Nilai set dapat digunakan sebagai voucher potongan untuk botol 50 ml berikutnya.';
const discoveryPrice = Number(discoverySec?.contentData?.price || 450000);
const discoveryCtaText = discoverySec?.contentData?.ctaText || 'Pesan Discovery Set';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Omoo',
  url: 'https://omoo.studio',
  email: site.email,
  sameAs: site.socials.map((social) => social.href),
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer care',
    email: site.email,
    telephone: site.whatsapp.display,
    availableLanguage: ['Indonesian', 'English', 'French'],
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: '12190',
    addressLocality: 'Jakarta Selatan',
    addressRegion: 'DKI Jakarta',
    addressCountry: 'ID',
  },
};
---

<BaseLayout
  title="Perfume, made slowly"
  description="Omoo adalah rumah parfum kecil di Jakarta. Enam komposisi extrait de parfum, diracik dari material pilihan, dibuat perlahan."
  schema={schema}
>
  {showHero && (
  <section class="relative overflow-hidden pb-[clamp(3rem,6vw,5rem)] pt-[clamp(1.5rem,4vw,3rem)]" data-section-template="HERO_EDITORIAL" data-section-name="Hero Editorial">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
      <div
        data-mist
        class="absolute -left-40 top-0 h-[30rem] w-[30rem] rounded-full bg-accent-fill/25 blur-[90px]"
      ></div>
      <div
        data-mist
        class="absolute right-[-12%] top-[18%] h-[26rem] w-[26rem] rounded-full bg-line/50 blur-[110px]"
      ></div>
    </div>

    <div class="relative mx-auto w-full max-w-page px-gutter">
      <div class="grid items-stretch gap-10 lg:grid-cols-[7fr_5fr] lg:gap-[clamp(2rem,5vw,5rem)]">
        <div class="flex flex-col justify-center py-[clamp(1rem,4vw,3.5rem)]">
          <Eyebrow data-hero-fade style="--hero-delay: 0s"><span data-editable-id="hero-eyebrow">{heroEyebrow}</span></Eyebrow>

          <h1
            class="mt-7 font-display text-[clamp(3.35rem,7.7vw,7.75rem)] font-light leading-[0.9] tracking-[-0.022em] text-balance"
          >
            <span class="block overflow-hidden pb-[0.08em]">
              <span data-hero-line style="--line-delay: 0.06s" class="block" data-editable-id="hero-title">
                {heroTitle}
              </span>
            </span>
          </h1>

          <p
            data-hero-fade
            style="--hero-delay: 0.38s"
            class="mt-7 max-w-[38ch] text-[clamp(1rem,1.25vw,1.15rem)] leading-[1.65] text-muted"
            data-editable-id="hero-subtitle"
          >
            {heroSubtitle}
          </p>

          <div
            data-hero-fade
            style="--hero-delay: 0.48s"
            class="mt-9 flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-8"
          >
            <Button href={heroCtaLink} class="w-full sm:w-auto"><span data-editable-id="hero-cta">{heroCtaText}</span></Button>
            <ArrowLink href={heroSecondaryLink}><span data-editable-id="hero-secondary">{heroSecondaryText}</span></ArrowLink>
          </div>
        </div>

        <div class="relative" data-editable-img="hero-bottle">
          <div class="relative z-10" data-parallax>
            <span
              aria-hidden="true"
              class="pointer-events-none absolute -left-4 -top-4 bottom-8 right-8 border border-line/70"
            ></span>

            <a
              href="/collection/"
              data-hero-media
              class="group relative z-10 block overflow-hidden"
              aria-label="View the OMOO collection"
            >
              <Media
                src={images.bottleSel}
                alt={alts.bottleSel}
                aspect="4 / 5"
                widths={[420, 600, 686]}
                sizes="(max-width: 1024px) 100vw, 42vw"
                priority
                quality={86}
                parallax
              />
            </a>

            <div
              data-float
              data-editable-img="hero-macro"
              class="absolute -bottom-6 -left-4 z-20 w-24 rotate-[-3deg] border-[6px] border-bg bg-bg shadow-[0_24px_60px_rgba(0,0,0,0.22)] sm:w-32 lg:w-40"
            >
              <div data-float-loop>
                <Media
                  src={images.macroOud}
                  alt={alts.macroOud}
                  aspect="1 / 1"
                  widths={[160, 240, 360]}
                  sizes="(max-width: 640px) 96px, 160px"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  )}

  {showShowcase && (
  <div data-section-template="FRAGRANCE_GRID" data-section-name="Katalog Wewangian">
  <Section>
    <SectionHeader
      linkHref="/collection/"
      linkLabel={showcaseSubtitle}
      class="mb-[clamp(2.5rem,5vw,4.5rem)]"
    >
      <span data-editable-id="showcase-eyebrow">{showcaseEyebrow}</span><br /><span class="italic" data-editable-id="showcase-title">{showcaseTitle}</span>
    </SectionHeader>

    <div class="grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-gutter">
      <a
        href={`/collection/${enrichedLead.slug}/`}
        class="group relative block [perspective:1200px] lg:col-span-6"
        data-tilt
      >
        <Media
          src={enrichedLead.bottle}
          alt={enrichedLead.bottleAlt}
          aspect="4 / 5"
          widths={[420, 620, 840, 1040]}
          sizes="(max-width: 1024px) 100vw, 48vw"
          tiltTarget
          reveal
          quality={85}
        />

        <div
          class="absolute -bottom-6 -right-4 z-10 hidden w-32 border-[6px] border-bg bg-bg shadow-[0_24px_60px_rgba(0,0,0,0.18)] sm:block lg:w-40"
        >
          <Media
            src={enrichedLead.macro}
            alt={enrichedLead.macroAlt}
            aspect="1 / 1"
            widths={[160, 240, 360]}
            sizes="160px"
          />
        </div>
      </a>

      <div class="lg:col-span-5 lg:col-start-8">
        <div class="relative">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-20 right-0 hidden select-none font-display text-[clamp(8rem,13vw,13rem)] font-light leading-[0.7] text-transparent [-webkit-text-stroke:1px_var(--color-line)] lg:block"
          >
            {enrichedLead.edition.split('-')[1]}
          </span>

          <p class="relative text-[0.65rem] font-medium uppercase tracking-[0.13em] text-muted">
            {enrichedLead.edition} / {enrichedLead.family}
          </p>
          <h3
            class="relative mt-4 font-display text-[clamp(2.6rem,4.4vw,4.6rem)] font-light leading-[0.94] tracking-[-0.022em]"
          >
            {enrichedLead.name}
          </h3>
          <p class="relative mt-4 font-display text-[clamp(1.3rem,1.8vw,1.65rem)] font-light italic leading-snug">
            {enrichedLead.tagline}
          </p>
          <p class="relative mt-5 max-w-[44ch] text-[0.95rem] leading-[1.7] text-muted">
            {enrichedLead.description}
          </p>

          <dl class="relative mt-7 grid grid-cols-3 gap-4 border-t border-line pt-4">
            {
              leadNotes.map((group) => (
                <div>
                  <dt class="text-[0.58rem] font-medium uppercase tracking-[0.12em] text-muted">
                    {group.label}
                  </dt>
                  <dd class="mt-2 text-[0.78rem] leading-[1.5]">{group.notes.join(', ')}</dd>
                </div>
              ))
            }
          </dl>

          <div class="relative mt-8 flex flex-wrap items-end justify-between gap-5 border-t border-line pt-4">
            <p class="flex items-baseline gap-3">
              <span class="font-display text-3xl">{priceLabel(enrichedLead.price)}</span>
              <span class="text-[0.68rem] uppercase tracking-[0.08em] text-muted">
                {enrichedLead.volume} / Extrait
              </span>
            </p>
            <ArrowLink href={`/collection/${enrichedLead.slug}/`}>Discover</ArrowLink>
          </div>
        </div>
      </div>
    </div>

    <div data-stagger class="mt-20 grid gap-12 sm:grid-cols-2 lg:mt-28 lg:grid-cols-3">
      {
        enrichedSecondary.map((fragrance) => (
          <FragranceCard fragrance={fragrance} aspect="4 / 5" />
        ))
      }
    </div>

    <div class="mt-16 border-t border-line pt-6">
      <p class="max-w-[40ch] font-display text-[clamp(1.5rem,2.4vw,2.2rem)] font-light leading-[1.08]" data-editable-id="showcase-quote">
        {showcaseFooterQuote}
      </p>
    </div>
  </Section>
  </div>
  )}

  {showMaterials && (
  <div data-section-template="MATERIAL_STORY" data-section-name="Eksplorasi Material Asal">
  <Section tone="surface" id="materials" labelledby="materials-heading" class="relative overflow-hidden">
    <div class="relative max-w-[54ch]">
      <SectionHeader id="materials-heading">
        <span data-editable-id="material-title">{materialTitle}</span>
      </SectionHeader>
      <p data-reveal class="mt-7 max-w-[42ch] text-[0.95rem] leading-[1.7] text-muted" data-editable-id="material-subtitle">
        {materialSubtitle}
      </p>
    </div>

    <div class="relative mt-12 grid gap-12 lg:mt-16 lg:grid-cols-12 lg:gap-gutter">
      <div class="hidden lg:col-span-5 lg:block" data-reveal-image>
        <div class="relative aspect-[4/5] overflow-hidden bg-bg" data-atlas>
          {
            materials.map((material, index) => (
              <div
                class:list={[
                  'absolute inset-0 transition-opacity duration-700 ease-luxe',
                  index === 0 ? 'opacity-100' : 'opacity-0',
                ]}
                data-atlas-frame={material.slug}
                aria-hidden={index === 0 ? 'false' : 'true'}
              >
                <Media src={material.image} alt="" fill class="h-full" sizes="40vw" />
              </div>
            ))
          }
        </div>

        <div class="mt-4 flex justify-between gap-6 text-[0.65rem] font-medium uppercase tracking-[0.13em] text-muted">
          <span data-atlas-caption-name>{materials[0].name}</span>
          <span data-atlas-caption-origin>{materials[0].origin}</span>
        </div>
      </div>

      <ul data-stagger class="lg:col-span-6 lg:col-start-7">
        {
          materials.map((material) => (
            <li class="border-b border-line" data-reveal>
              <a
                href={`/collection/${material.slug}/`}
                data-atlas-item={material.slug}
                data-atlas-name={material.name}
                data-atlas-origin={material.origin}
                class="group grid grid-cols-[1fr_auto] items-baseline gap-x-6 gap-y-1 py-6 md:py-7"
              >
                <span class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                  <span class="font-display text-[clamp(1.9rem,3.4vw,3rem)] font-light leading-none tracking-[-0.015em] transition-colors duration-300 ease-luxe group-hover:text-accent">
                    {material.name}
                  </span>
                  <span class="text-[0.65rem] font-medium uppercase tracking-[0.13em] text-muted">
                    {material.origin}
                  </span>
                </span>
                <span class="hidden text-right text-[0.7rem] uppercase tracking-[0.08em] text-muted md:block">
                  {material.phrase}
                </span>
                <span class="text-[0.8rem] text-muted md:hidden">{material.phrase}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>
  </div>
  )}

  {showQuiz && (
  <section class="relative overflow-hidden border-y border-line" data-section-template="RICH_TEXT_MEDIA" data-section-name="Konsultasi Scent">
    <div class="grid lg:grid-cols-2">
      <div class="relative min-h-[320px] overflow-hidden lg:min-h-[680px]" data-editable-img="quiz-img">
        <div class="absolute inset-0">
          <Media
            src={images.atelier}
            alt={alts.atelier}
            fill
            class="h-full"
            widths={[640, 960, 1280]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            parallax
            reveal
          />
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#0b0e08]/35 via-transparent to-transparent"></div>
      </div>

      <div class="relative flex flex-col justify-center bg-bg-tint px-gutter py-[clamp(3.5rem,7vw,6rem)] lg:py-24 lg:pl-[clamp(2rem,4vw,5rem)] lg:pr-[max(2.5rem,8vw)]">
        <div class="max-w-[37rem]">
          <h2
            data-reveal-title
            class="max-w-[13ch] pb-1 font-display text-[clamp(2.4rem,4.4vw,4.1rem)] font-light leading-[0.98] tracking-[-0.02em]"
          >
            <span data-editable-id="quiz-title">{quizTitle}</span><br /><span class="italic" data-editable-id="quiz-subtitle">{quizSubtitle}</span>
          </h2>
          <p data-reveal class="mt-6 max-w-[44ch] text-[0.95rem] leading-[1.7] text-muted" data-editable-id="quiz-desc">
            {quizDesc}
          </p>

          <dl class="mt-8 grid border-t border-line">
            <div data-reveal class="flex items-baseline justify-between gap-4 border-b border-line py-3">
              <dt class="font-display text-xl">Room</dt>
              <dd class="text-[0.7rem] uppercase tracking-[0.08em] text-muted" data-editable-id="quiz-item-room">{quizItemRoom}</dd>
            </div>
            <div data-reveal class="flex items-baseline justify-between gap-4 border-b border-line py-3">
              <dt class="font-display text-xl">Material</dt>
              <dd class="text-[0.7rem] uppercase tracking-[0.08em] text-muted" data-editable-id="quiz-item-material">{quizItemMaterial}</dd>
            </div>
            <div data-reveal class="flex items-baseline justify-between gap-4 border-b border-line py-3">
              <dt class="font-display text-xl">Trace</dt>
              <dd class="text-[0.7rem] uppercase tracking-[0.08em] text-muted" data-editable-id="quiz-item-trace">{quizItemTrace}</dd>
            </div>
          </dl>

          <div data-reveal class="mt-8">
            <Button href={quizCtaLink}><span data-editable-id="quiz-cta">{quizCtaText}</span></Button>
          </div>
        </div>
      </div>
    </div>
  </section>
  )}

  {showQuote && (
