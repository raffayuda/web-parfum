<script>
  import { animate } from 'motion';

  const atlas = document.querySelector<HTMLElement>('[data-atlas]');
  const items = document.querySelectorAll<HTMLElement>('[data-atlas-item]');
  const captionName = document.querySelector<HTMLElement>('[data-atlas-caption-name]');
  const captionOrigin = document.querySelector<HTMLElement>('[data-atlas-caption-origin]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (atlas) {
    const frames = Array.from(atlas.querySelectorAll<HTMLElement>('[data-atlas-frame]'));

    const activate = (item: HTMLElement) => {
      const slug = item.dataset.atlasItem;

      frames.forEach((frame) => {
        const active = frame.dataset.atlasFrame === slug;
        frame.setAttribute('aria-hidden', active ? 'false' : 'true');
        frame.classList.toggle('opacity-100', active);
        frame.classList.toggle('opacity-0', !active);

        if (!reduceMotion) {
          animate(
            frame,
            { opacity: active ? 1 : 0, scale: active ? 1 : 1.035 },
            { duration: 0.65, ease: [0.16, 1, 0.3, 1] }
          );
        }
      });

      if (captionName) captionName.textContent = item.dataset.atlasName ?? '';
      if (captionOrigin) captionOrigin.textContent = item.dataset.atlasOrigin ?? '';
    };

    items.forEach((item) => {
      item.addEventListener('mouseenter', () => activate(item));
      item.addEventListener('focus', () => activate(item));
    });
  }
</script>
