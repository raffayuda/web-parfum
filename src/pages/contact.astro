---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Button from '../components/ui/Button.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import Section from '../components/ui/Section.astro';
import SocialLinks from '../components/ui/SocialLinks.astro';
import Faq from '../components/ui/Faq.astro';
import { Icon } from 'astro-icon/components';
import { site, whatsappHref } from '../data/site';
import { prisma } from '../../server/src/db';
import { defaultSettings } from '../../server/src/routes/settings';

export const prerender = false;

let dbSections: any[] = [];
let dbElements: Record<string, string> = {};
let settings: any = { ...defaultSettings };

try {
  const [contactPage, settingsPage] = await Promise.all([
    prisma.page.findUnique({
      where: { slug: 'contact' },
      include: {
        sections: {
          orderBy: { order: 'asc' },
        },
      },
    }),
    prisma.page.findUnique({
      where: { slug: 'site-settings' },
      include: { sections: true },
    }),
  ]);

  if (contactPage) {
    dbSections = contactPage.sections;
    for (const sec of contactPage.sections) {
      const c = (sec.contentData as any) || {};
      if (c.elements) dbElements = { ...dbElements, ...c.elements };
    }
  }

  if (settingsPage && settingsPage.sections.length > 0) {
    const c = (settingsPage.sections[0].contentData as any) || {};
    settings = { ...defaultSettings, ...c };
  }
} catch (e) {}

const contactHero = dbSections.find((s) => s.template === 'HERO_SPLIT');
const contactFaqSec = dbSections.find((s) => s.template === 'FAQ_ACCORDION');

const headerDeck =
  dbElements['contact-deck'] ||
  contactHero?.subtitle ||
  'Kantor dan studio kami buka dengan janji temu. Untuk pertanyaan tentang koleksi parfum, ketersediaan stok, atau pemesanan langsung, hubungi kami via WhatsApp atau email.';
const headerTitle = dbElements['contact-title'] || contactHero?.title || '';

const officeTitle = dbElements['contact-office-title'] || settings.officeTitle || 'Kantor & Studio OMOO';
const street = dbElements['contact-street'] || settings.street || site.address.street;
const city = dbElements['contact-city'] || settings.city || site.address.city;
const country = dbElements['contact-country'] || settings.country || site.address.country;
const hours = dbElements['contact-hours'] || settings.hours || 'Senin - Sabtu: 10.00 - 20.00 WIB';
const visitNote = dbElements['contact-visit-note'] || settings.visitNote || 'Dengan janji temu';
const email = dbElements['contact-email'] || settings.email || site.email;
const whatsappDisplay = settings.whatsappDisplay || site.whatsapp.display;
const whatsappRaw = String(settings.whatsappNumber || site.whatsapp.number).replace(/\D/g, '');
const whatsappNum = whatsappRaw.startsWith('0') ? `62${whatsappRaw.slice(1)}` : whatsappRaw;
const dynamicWhatsappHref = (text: string) =>
  `https://wa.me/${whatsappNum}?text=${encodeURIComponent(text)}`;

const mapLat = Number(settings.mapLat) || -6.2297;
const mapLng = Number(settings.mapLng) || 106.8073;
const mapEmbedUrl = `https://maps.google.com/maps?q=${mapLat},${mapLng}&z=16&output=embed`;
const googleMapsExternalUrl =
  settings.googleMapsUrl?.trim() ||
  `https://www.google.com/maps/search/?api=1&query=${mapLat},${mapLng}`;

const faq = [
  {
    question: 'Bisakah saya berkunjung langsung ke kantor / studio OMOO?',
    answer:
      `Tentu bisa. Kunjungan dapat dijadwalkan terlebih dahulu via WhatsApp atau email ${email} untuk mencocokkan waktu kedatangan.`,
  },
  {
    question: 'Bagaimana cara memesan parfum?',
    answer:
      'Pemesanan dapat dilakukan langsung di website ini dengan memilih produk, menambahkannya ke keranjang, dan checkout via QRIS, atau langsung memesan melalui WhatsApp resmi OMOO.',
  },
  {
    question: 'Berapa lama estimasi pengiriman pesanan?',
    answer:
      'Pesanan dikirimkan dalam 1-2 hari kerja menggunakan ekspedisi terpercaya (JNE YES / Paxel) dengan kemasan botol aman berlapis bubble wrap tebal dan asuransi pengiriman.',
  },
  {
    question: 'Bagaimana cara menyimpan botol parfum yang benar?',
    answer:
      'Simpan botol parfum dalam posisi berdiri tegak, di tempat sejuk dan terhindar dari paparan sinar matahari langsung atau suhu panas berlebih agar kualitas aroma tetap terjaga sempurna.',
  },
  {
    question: 'Apakah wewangian OMOO cocok untuk pria dan wanita (unisex)?',
    answer:
      'Ya, seluruh wewangian OMOO dirancang unisex. Setiap orang bebas memilih aroma yang paling cocok dengan karakter dan selera masing-masing.',
  },
  {
    question: 'Apakah produk OMOO sudah terdaftar BPOM dan Halal?',
    answer:
      'Ya, seluruh produk wewangian OMOO telah teruji aman dan resmi terdaftar di BPOM RI serta bersertifikasi Halal.',
  },
];

const dynamicFaqs = (contactFaqSec?.contentData?.faqs || []).map((f: any) => ({
  question: f.q || f.question,
  answer: f.a || f.answer,
}));
const allFaqs = dynamicFaqs.length > 0 ? dynamicFaqs : faq;
---

<BaseLayout
  title="Kontak"
  description="Lokasi kantor & studio OMOO di peta, atau hubungi kami lewat WhatsApp dan email untuk informasi koleksi dan pemesanan."
>
  <PageHeader deck={headerDeck}>
    <Fragment slot="title">
      {headerTitle ? (
        <span data-editable-id="contact-title">{headerTitle}</span>
      ) : (
        <span data-editable-id="contact-title">Kunjungi, Hubungi <span class="italic">&amp; Pesan.</span></span>
      )}
    </Fragment>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <p class="text-[0.62rem] font-medium uppercase tracking-[0.14em] text-muted">
        Media Sosial
      </p>
      <SocialLinks variant="icons" whatsapp />
    </div>
  </PageHeader>

  <Section spacing="tight" class="pt-0">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
      {/* Peta Lokasi Kantor Perusahaan */}
      <div class="lg:col-span-5 border border-line bg-surface/20 flex flex-col">
        <div class="relative w-full aspect-[4/5] min-h-[380px] bg-surface overflow-hidden">
          <iframe
            title={`Peta Lokasi ${officeTitle}`}
            src={mapEmbedUrl}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="w-full h-full border-0"
            allowfullscreen
          />
        </div>
        <div class="p-4 border-t border-line bg-bg flex items-center justify-between gap-3 text-xs">
          <div class="min-w-0">
            <span class="text-[0.6rem] uppercase tracking-[0.14em] text-accent font-semibold block">
              Peta Kantor Perusahaan
            </span>
            <p class="text-muted truncate mt-0.5">{street}, {city}</p>
          </div>
          <a
            href={googleMapsExternalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 border border-line hover:border-ink text-[0.65rem] uppercase tracking-wider font-semibold text-ink transition-colors"
          >
            <span>Google Maps</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <div data-reveal class="lg:col-span-6 lg:col-start-7 lg:pt-4">
        <h2
          data-reveal-title
          data-editable-id="contact-office-title"
          class="max-w-[14ch] pb-1 font-display text-[clamp(2.35rem,4.4vw,4.25rem)] font-light leading-[0.98] tracking-[-0.02em]"
        >
          {officeTitle}
        </h2>

        <address class="mt-7 text-[1.05rem] leading-[1.8] not-italic">
          <span data-editable-id="contact-street">{street}</span><br />
          <span data-editable-id="contact-city">{city}</span><br />
          <span data-editable-id="contact-country">{country}</span>
        </address>

        <dl class="mt-8 grid gap-0 border-t border-line">
          <div class="flex items-baseline justify-between gap-6 border-b border-line py-3">
            <dt class="text-[0.65rem] uppercase tracking-[0.12em] text-muted">Jam</dt>
            <dd class="text-right text-[0.9rem]" data-editable-id="contact-hours">{hours}</dd>
          </div>
          <div class="flex items-baseline justify-between gap-6 border-b border-line py-3">
            <dt class="text-[0.65rem] uppercase tracking-[0.12em] text-muted">Kunjungan</dt>
            <dd class="text-right text-[0.9rem]" data-editable-id="contact-visit-note">{visitNote}</dd>
          </div>
          <div class="flex items-baseline justify-between gap-6 border-b border-line py-3">
            <dt class="text-[0.65rem] uppercase tracking-[0.12em] text-muted">Email</dt>
            <dd class="text-right text-[0.9rem]">
              <a class="underline underline-offset-4 transition-colors hover:text-accent" href={`mailto:${email}`} data-editable-id="contact-email">
                {email}
              </a>
            </dd>
          </div>
          <div class="flex items-baseline justify-between gap-6 border-b border-line py-3">
            <dt class="text-[0.65rem] uppercase tracking-[0.12em] text-muted">WhatsApp</dt>
            <dd class="text-right text-[0.9rem]">
              <a
                class="underline underline-offset-4 transition-colors hover:text-accent"
                href={dynamicWhatsappHref('Halo OMOO, saya ingin bertanya tentang koleksi dan pemesanan.')}
                target="_blank"
                rel="noopener noreferrer"
              >
                {whatsappDisplay}
              </a>
            </dd>
          </div>
        </dl>

        <div class="mt-8 flex flex-col items-start gap-4">
          <Button
            href={dynamicWhatsappHref('Halo OMOO, saya ingin bertanya tentang koleksi dan pemesanan.')}
            external
            class="w-full sm:w-auto"
          >
            <span class="inline-flex items-center gap-2">
              <Icon name="ph:whatsapp-logo" size={16} aria-hidden="true" />
              Chat via WhatsApp
            </span>
          </Button>
          <ArrowLink href={`mailto:${email}`}>Kirim Email</ArrowLink>
          <p class="max-w-[40ch] text-[0.75rem] leading-relaxed text-muted">
            Janji temu dikonfirmasi lewat email atau WhatsApp dalam 1-2 hari kerja.
          </p>
        </div>

      </div>
    </div>
  </Section>

  <Section tone="surface" spacing="tight">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2
          data-reveal-title
          class="max-w-[9ch] pb-1 font-display text-[clamp(2.35rem,4.4vw,4.25rem)] font-light leading-[0.98] tracking-[-0.02em]"
        >
          Tanya Jawab
        </h2>
        <p class="mt-5 max-w-[32ch] text-[0.9rem] leading-[1.7] text-muted">
          Jawaban singkat untuk pertanyaan yang paling sering diajukan.
        </p>
      </div>

      <div class="lg:col-span-7 lg:col-start-6">
        <Faq items={allFaqs} />
      </div>
    </div>
  </Section>
</BaseLayout>
