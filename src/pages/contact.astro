---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Button from '../components/ui/Button.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import Media from '../components/ui/Media.astro';
import Section from '../components/ui/Section.astro';
import SocialLinks from '../components/ui/SocialLinks.astro';
import Faq from '../components/ui/Faq.astro';
import { Icon } from 'astro-icon/components';
import { images, alts } from '../data/images';
import { site, whatsappHref } from '../data/site';
import { prisma } from '../../server/src/db';

let dbSections: any[] = [];
try {
  const page = await prisma.page.findUnique({
    where: { slug: 'contact' },
    include: {
      sections: {
        orderBy: { order: 'asc' },
      },
    },
  });
  if (page) dbSections = page.sections;
} catch (e) {}

const contactHero = dbSections.find((s) => s.template === 'HERO_SPLIT');
const contactFaqSec = dbSections.find((s) => s.template === 'FAQ_ACCORDION');

const headerDeck = contactHero?.subtitle || 'Toko kami buka dengan janji temu. Untuk pertanyaan tentang koleksi parfum, ketersediaan stok, atau pemesanan langsung, hubungi kami via WhatsApp atau email.';
const headerTitle = contactHero?.title || 'Kunjungi, Hubungi & Pesan.';

const stockists = [
  {
    city: 'Jakarta',
    name: 'Ruang Wangi',
    address: 'Jl. Cipete Raya No. 8\nJakarta Selatan',
  },
  {
    city: 'Bandung',
    name: 'Niskala',
    address: 'Jl. Braga No. 18\nBandung',
  },
  {
    city: 'Bali',
    name: 'Hening',
    address: 'Jl. Raya Seminyak No. 9\nBadung, Bali',
  },
];

const faq = [
  {
    question: 'Bisakah saya berkunjung langsung ke toko / butik OMOO?',
    answer:
      'Tentu bisa. Kunjungan dibuka Selasa sampai Jumat dengan konfirmasi terlebih dahulu. Anda bisa chat ke WhatsApp kami atau email hello@omoo.studio untuk mencocokkan jadwal kedatangan.',
  },
  {
    question: 'Bagaimana cara memesan parfum?',
    answer:
      'Pemesanan dapat dilakukan langsung di website ini dengan memilih produk dan checkout via QRIS/Transfer, atau bisa juga langsung memesan secara praktis melalui WhatsApp resmi OMOO.',
  },
  {
    question: 'Berapa lama estimasi pengiriman pesanan?',
    answer:
      'Pesanan dikirimkan dalam 1-2 hari kerja menggunakan ekspedisi terpercaya (JNE YES / Paxel) dengan kemasan botol aman berlapis bubble wrap tebal dan asuransi pengiriman.',
  },
  {
    question: 'Bagaimana cara menyimpan botol parfum yang benar?',
    answer:
      'Simpan botol parfum dalam posisi berdiri tegak, di tempat sejuk dan terhindar dari paparan sinar matahari langsung atau suhu panas berlebih agar kualitas aroma tetap terjaga sempurna.',
  },
  {
    question: 'Apakah wewangian OMOO cocok untuk pria dan wanita (unisex)?',
    answer:
      'Ya, seluruh wewangian OMOO dirancang unisex. Setiap orang bebas memilih aroma yang paling cocok dengan karakter dan selera masing-masing.',
  },
  {
    question: 'Apakah produk OMOO sudah terdaftar BPOM dan Halal?',
    answer:
      'Ya, seluruh produk wewangian OMOO telah teruji aman dan resmi terdaftar di BPOM RI serta bersertifikasi Halal.',
  },
];

const dynamicFaqs = (contactFaqSec?.contentData?.faqs || []).map((f: any) => ({
  question: f.q || f.question,
  answer: f.a || f.answer,
}));
const allFaqs = dynamicFaqs.length > 0 ? dynamicFaqs : faq;
---

<BaseLayout
  title="Kontak"
  description="Kunjungi studio OMOO di Jakarta, atau hubungi kami lewat WhatsApp dan email untuk informasi koleksi dan pemesanan."
>
  <PageHeader deck={headerDeck}>
    <Fragment slot="title">
      {contactHero?.title ? (
        <span>{headerTitle}</span>
      ) : (
        <>Kunjungi, Hubungi <span class="italic">&amp; Pesan.</span></>
      )}
    </Fragment>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <p class="text-[0.62rem] font-medium uppercase tracking-[0.14em] text-muted">
        Media Sosial
      </p>
      <SocialLinks variant="icons" whatsapp />
    </div>
  </PageHeader>

  <Section spacing="tight" class="pt-0">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
      <Media
        src={images.atelierDoor}
        alt={alts.atelierDoor}
        aspect="4 / 5"
        widths={[400, 600, 800, 1000]}
        sizes="(max-width: 1024px) 100vw, 48vw"
        class="lg:col-span-5"
        priority
        reveal
      />

      <div data-reveal class="lg:col-span-6 lg:col-start-7 lg:pt-4">
        <h2
          data-reveal-title
          class="max-w-[10ch] pb-1 font-display text-[clamp(2.35rem,4.4vw,4.25rem)] font-light leading-[0.98] tracking-[-0.02em]"
        >
          Studio Jakarta
        </h2>

        <address class="mt-7 text-[1.05rem] leading-[1.8] not-italic">
          {site.address.street}<br />
          {site.address.city}<br />
          {site.address.country}
        </address>

        <dl class="mt-8 grid gap-0 border-t border-line">
          <div class="flex items-baseline justify-between gap-6 border-b border-line py-3">
            <dt class="text-[0.65rem] uppercase tracking-[0.12em] text-muted">Jam</dt>
            <dd class="text-right text-[0.9rem]">Selasa sampai Jumat, 10.00 sampai 18.00 WIB</dd>
          </div>
          <div class="flex items-baseline justify-between gap-6 border-b border-line py-3">
            <dt class="text-[0.65rem] uppercase tracking-[0.12em] text-muted">Sabtu</dt>
            <dd class="text-right text-[0.9rem]">Dengan janji temu</dd>
          </div>
          <div class="flex items-baseline justify-between gap-6 border-b border-line py-3">
            <dt class="text-[0.65rem] uppercase tracking-[0.12em] text-muted">Email</dt>
            <dd class="text-right text-[0.9rem]">
              <a class="underline underline-offset-4 transition-colors hover:text-accent" href={`mailto:${site.email}`}>
                {site.email}
              </a>
            </dd>
          </div>
          <div class="flex items-baseline justify-between gap-6 border-b border-line py-3">
            <dt class="text-[0.65rem] uppercase tracking-[0.12em] text-muted">WhatsApp</dt>
            <dd class="text-right text-[0.9rem]">
              <a
                class="underline underline-offset-4 transition-colors hover:text-accent"
                href={whatsappHref('Halo OMOO, saya ingin bertanya tentang koleksi dan pemesanan.')}
                target="_blank"
                rel="noopener noreferrer"
              >
                {site.whatsapp.display}
              </a>
            </dd>
          </div>
        </dl>

        <div class="mt-8 flex flex-col items-start gap-4">
          <Button
            href={whatsappHref('Halo OMOO, saya ingin bertanya tentang koleksi dan pemesanan.')}
            external
            class="w-full sm:w-auto"
          >
            <span class="inline-flex items-center gap-2">
              <Icon name="ph:whatsapp-logo" size={16} aria-hidden="true" />
              Chat via WhatsApp
            </span>
          </Button>
          <ArrowLink href={`mailto:${site.email}`}>Kirim Email</ArrowLink>
          <p class="max-w-[40ch] text-[0.75rem] leading-relaxed text-muted">
            Janji temu dikonfirmasi lewat email atau WhatsApp dalam 1-2 hari kerja.
          </p>
        </div>

      </div>
    </div>
  </Section>

  <Section tone="surface" spacing="tight">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2
          data-reveal-title
          class="max-w-[9ch] pb-1 font-display text-[clamp(2.35rem,4.4vw,4.25rem)] font-light leading-[0.98] tracking-[-0.02em]"
        >
          Tanya Jawab
        </h2>
        <p class="mt-5 max-w-[32ch] text-[0.9rem] leading-[1.7] text-muted">
          Jawaban singkat untuk pertanyaan yang paling sering diajukan.
        </p>
      </div>

      <div class="lg:col-span-7 lg:col-start-6">
        <Faq items={allFaqs} />
      </div>
    </div>
  </Section>
</BaseLayout>
