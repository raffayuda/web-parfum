---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Button from '../components/ui/Button.astro';
import Media from '../components/ui/Media.astro';
import Section from '../components/ui/Section.astro';
import { images, alts } from '../data/images';

const stockists = [
  {
    city: 'Paris',
    name: 'Le Comptoir',
    address: '8 rue de Bretagne\n75003 Paris',
  },
  {
    city: 'London',
    name: 'Avery & Sons',
    address: "22 Lamb's Conduit Street\nLondon WC1N 3LL",
  },
  {
    city: 'Tokyo',
    name: 'Hako',
    address: '2-14-5 Jingumae\nShibuya, Tokyo',
  },
];

const faq = [
  {
    question: 'Can I visit the atelier?',
    answer:
      'Yes. Visits are by appointment, Tuesday to Friday. Write to hello@omoo.studio with a day and time that suits you, and we will confirm.',
  },
  {
    question: 'Do you ship outside Europe?',
    answer:
      'Not yet. The atelier ships within Europe. If you are further away, write to us and we will let you know when that changes.',
  },
  {
    question: 'Do you offer samples?',
    answer:
      'Two 2 ml vials per request, sent from Paris. Tell us which compositions you would like to try, or ask us to choose.',
  },
  {
    question: 'How should I store a bottle?',
    answer:
      'Upright, away from light and heat. A cupboard is better than a bathroom shelf. Extrait de parfum keeps for years when it is left alone.',
  },
  {
    question: 'Are the fragrances unisex?',
    answer:
      'Yes. We do not divide the collection by gender. The material is the only brief.',
  },
];
---

<BaseLayout
  title="Contact"
  description="Visit the Omoo atelier in Paris, find a stockist, or write to us about samples and the collection."
>
  <PageHeader
    deck="The atelier is open by appointment. For samples, stockist enquiries, or a conversation about a material, write to us."
  >
    <Fragment slot="title">Visit, write,<br /><span class="italic">smell.</span></Fragment>
  </PageHeader>

  <Section spacing="tight" class="pt-0">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
      <Media
        src={images.atelierDoor}
        alt={alts.atelierDoor}
        aspect="4 / 5"
        widths={[400, 600, 800, 1000]}
        sizes="(max-width: 1024px) 100vw, 48vw"
        class="lg:col-span-5"
        priority
        reveal
      />

      <div data-reveal class="lg:col-span-6 lg:col-start-7 lg:pt-4">
        <h2 data-reveal-title class="max-w-[10ch] pb-1 font-display text-[clamp(2.35rem,4.4vw,4.25rem)] font-light leading-[0.98] tracking-[-0.02em]">
          The atelier
        </h2>

        <address class="mt-7 text-[1.05rem] leading-[1.8] not-italic">
          14 rue de Poitou<br />
          75003 Paris<br />
          France
        </address>

        <dl class="mt-8 grid gap-0 border-t border-line">
          <div class="flex items-baseline justify-between gap-6 border-b border-line py-3">
            <dt class="text-[0.65rem] uppercase tracking-[0.12em] text-muted">Hours</dt>
            <dd class="text-right text-[0.9rem]">Tuesday to Friday, 10:00 to 18:00</dd>
          </div>
          <div class="flex items-baseline justify-between gap-6 border-b border-line py-3">
            <dt class="text-[0.65rem] uppercase tracking-[0.12em] text-muted">Saturday</dt>
            <dd class="text-right text-[0.9rem]">By appointment</dd>
          </div>
          <div class="flex items-baseline justify-between gap-6 border-b border-line py-3">
            <dt class="text-[0.65rem] uppercase tracking-[0.12em] text-muted">Email</dt>
            <dd class="text-right text-[0.9rem]">
              <a class="underline underline-offset-4 transition-colors hover:text-accent" href="mailto:hello@omoo.studio">
                hello@omoo.studio
              </a>
            </dd>
          </div>
        </dl>

        <div class="mt-8 flex flex-col items-start gap-4">
          <Button href="mailto:hello@omoo.studio" class="w-full sm:w-auto">Write to us</Button>
          <p class="max-w-[38ch] text-[0.75rem] leading-relaxed text-muted">
            Appointments are confirmed by email. Please allow two working days.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <Section>
    <div class="grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 data-reveal-title class="max-w-[10ch] pb-1 font-display text-[clamp(2.35rem,4.4vw,4.25rem)] font-light leading-[0.98] tracking-[-0.02em]">
          Selected stockists
        </h2>
      </div>
      <div class="lg:col-span-7 lg:col-start-6">
        <div data-stagger class="grid border-t border-line sm:grid-cols-3">
          {
            stockists.map((stockist) => (
              <div data-reveal class="border-b border-line py-6 sm:border-b-0 sm:border-r sm:px-6 sm:first:pl-0 sm:last:border-r-0">
                <p class="font-display text-2xl font-light">{stockist.city}</p>
                <p class="mt-2 text-[0.85rem] leading-[1.6] text-muted whitespace-pre-line">
                  {stockist.name}
                  {'\n'}
                  {stockist.address}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </Section>

  <Section tone="surface" spacing="tight">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 data-reveal-title class="max-w-[9ch] pb-1 font-display text-[clamp(2.35rem,4.4vw,4.25rem)] font-light leading-[0.98] tracking-[-0.02em]">
          Questions
        </h2>
        <p class="mt-5 max-w-[32ch] text-[0.9rem] leading-[1.7] text-muted">
          The shortest answers to the things we are asked most often.
        </p>
      </div>

      <div class="lg:col-span-7 lg:col-start-6">
        {
          faq.map((item) => (
            <details class="group border-t border-line py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-[0.95rem] [&::-webkit-details-marker]:hidden">
                <span>{item.question}</span>
                <span
                  aria-hidden="true"
                  class="flex-none text-lg text-muted transition-transform duration-300 ease-luxe group-open:rotate-45"
                >
                  +
                </span>
              </summary>
              <p class="mt-3 max-w-[58ch] text-[0.88rem] leading-[1.7] text-muted">
                {item.answer}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </Section>
</BaseLayout>
