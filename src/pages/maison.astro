---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Button from '../components/ui/Button.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import Media from '../components/ui/Media.astro';
import Section from '../components/ui/Section.astro';
import { images, alts } from '../data/images';

const sources = [
  {
    name: 'Vetiver',
    origin: 'Haiti',
    copy: 'Akar diangkat dengan tangan, dikeringkan di bawah naungan, lalu disuling dekat ladang.',
    image: images.macroVetiver,
    alt: alts.macroVetiver,
    aspect: '3 / 4',
  },
  {
    name: 'Iris',
    origin: 'Tuscany',
    copy: 'Rizom dibiarkan beristirahat bertahun-tahun sebelum disuling. Bedaknya adalah tujuannya.',
    image: images.macroIris,
    alt: alts.macroIris,
    aspect: '1 / 1',
  },
  {
    name: 'Oud',
    origin: 'Assam',
    copy: 'Kayu resin, dibeli dalam lot kecil. Tidak ada yang diencerkan dengan bahan sintetis.',
    image: images.macroOud,
    alt: alts.macroOud,
    aspect: '3 / 4',
  },
];

const history = [
  {
    year: '2019',
    copy: 'Camille Aumont mendaftarkan Omoo dan membuka atelier kecil di Jakarta Selatan.',
  },
  {
    year: '2021',
    copy: 'Vetiver Obscura dan Iris Cendre untuk pertama kali dikemas.',
  },
  {
    year: '2023',
    copy: 'Ruang maceration dibangun di belakang atelier, menggandakan ruang istirahat.',
  },
  {
    year: '2026',
    copy: 'Ambrette 12 melengkapi koleksi menjadi enam komposisi.',
  },
];
---

<BaseLayout
  title="Maison"
  description="Omoo adalah rumah parfum di Jakarta. Enam komposisi, satu material pada satu waktu, dibuat perlahan."
>
  <PageHeader
    deck="Omoo bekerja dari atelier kecil di Jakarta, dengan material yang dipilih dari Grasse dan sekitarnya. Koleksinya sengaja dibuat pendek."
  >
    <Fragment slot="title">
      A house built around<br /><span class="italic">one material</span> at a time.
    </Fragment>
  </PageHeader>

  <Media
    src={images.atelier}
    alt={alts.atelier}
    fill
    class="h-[clamp(300px,46vw,560px)] w-full"
    imgClass="object-bottom"
    widths={[720, 1080, 1600]}
    sizes="100vw"
    priority
    parallax
    reveal
  />

  <Section>
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 data-reveal-title class="max-w-[13ch] pb-1 font-display text-[clamp(2.35rem,4.4vw,4.25rem)] font-light leading-[0.98] tracking-[-0.02em]">
          We began with a question.
        </h2>
      </div>
      <div class="grid gap-5 lg:col-span-7 lg:col-start-6">
        <p class="max-w-[56ch] text-[1.05rem] leading-[1.75]">
          Bagaimana jika sebuah parfum dibangun seperti sebuah ruangan? Satu material sebagai
          struktur, yang lain sebagai cahaya, udara, dan tempat untuk duduk.
        </p>
        <p data-reveal class="max-w-[56ch] text-[0.95rem] leading-[1.75] text-muted">
          Omoo dimulai sebagai buku catatan material: vetiver dari Haiti, iris dari Tuscany, fig dari
          Calabria. Setiap parfum berawal dari satu catatan dan tetap dekat padanya. Kami tidak
          menambahkan apa pun agar formula terasa lengkap. Jika sebuah note tidak bekerja, ia keluar.
        </p>
        <p data-reveal class="max-w-[56ch] text-[0.95rem] leading-[1.75] text-muted">
          Ada enam komposisi. Tidak akan ada enam puluh. Yang baru menggantikan yang lama ketika
          yang lama sudah mengatakan semua yang bisa dikatakannya.
        </p>
      </div>
    </div>
  </Section>

  <Section tone="surface">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
      <Media
        src={images.perfumer}
        alt={alts.perfumer}
        aspect="4 / 5"
        widths={[360, 540, 760]}
        sizes="(max-width: 1024px) 100vw, 38vw"
        class="lg:col-span-5"
      />

      <div class="lg:col-span-6 lg:col-start-7">
        <h2 data-reveal-title class="max-w-[12ch] pb-1 font-display text-[clamp(2.35rem,4.4vw,4.25rem)] font-light leading-[0.98] tracking-[-0.02em]">
          Camille Aumont
        </h2>
        <p class="mt-3 text-[0.65rem] font-medium uppercase tracking-[0.13em] text-muted">
          Founder and perfumer
        </p>

        <div class="mt-8 grid gap-5">
          <p class="max-w-[50ch] text-[0.95rem] leading-[1.75] text-muted">
            Camille belajar botani sebelum menjadi perfumer. Ia membuka Omoo di Jakarta pada 2019
            setelah sepuluh tahun di Grasse, sebagian besar mengerjakan material yang tidak dicari orang.
          </p>
          <p class="max-w-[50ch] text-[0.95rem] leading-[1.75] text-muted">
            Ia berkomposisi di meja kecil dekat jendela, biasanya sebelum atelier buka. Enam
            formula di koleksi ini adalah miliknya.
          </p>
          <p class="max-w-[50ch] font-display text-[clamp(1.45rem,2.3vw,1.9rem)] font-light italic leading-[1.2]">
            &ldquo;If you cannot smell the material, start again.&rdquo;
          </p>
        </div>
      </div>
    </div>
  </Section>

  <Section>
    <div class="max-w-[58ch]">
      <h2 data-reveal-title class="pb-1 font-display text-[clamp(2.35rem,4.8vw,4.75rem)] font-light leading-[0.98] tracking-[-0.02em]">
        Sourced, then left alone.
      </h2>
      <p class="mt-6 max-w-[44ch] text-[0.95rem] leading-[1.7] text-muted">
        Kami membeli dalam lot kecil dan bekerja dengan petani yang sama dari musim ke musim.
        Materialnya berubah; pendekatannya tidak.
      </p>
    </div>

    <div data-stagger class="mt-12 grid gap-10 sm:grid-cols-2 lg:mt-16 lg:grid-cols-12 lg:gap-gutter">
      {
        sources.map((source) => (
          <div class="lg:col-span-4">
            <Media
              src={source.image}
              alt={source.alt}
              aspect={source.aspect}
              widths={[320, 480, 640]}
              sizes="(max-width: 1024px) 50vw, 30vw"
            />
            <div class="mt-4 flex items-baseline justify-between gap-4 border-t border-line pt-3">
              <h3 class="font-display text-2xl font-light">{source.name}</h3>
              <span class="text-[0.62rem] uppercase tracking-[0.12em] text-muted">{source.origin}</span>
            </div>
            <p class="mt-3 max-w-[34ch] text-[0.88rem] leading-[1.6] text-muted">{source.copy}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section tone="surface" spacing="tight">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 data-reveal-title class="max-w-[10ch] pb-1 font-display text-[clamp(2.35rem,4.4vw,4.25rem)] font-light leading-[0.98] tracking-[-0.02em]">
          A short history.
        </h2>
      </div>
      <ol data-stagger class="lg:col-span-7 lg:col-start-6">
        {
          history.map((entry) => (
            <li data-reveal class="grid gap-2 border-t border-line py-6 sm:grid-cols-[7rem_1fr] sm:gap-6">
              <span class="font-display text-2xl font-light">{entry.year}</span>
              <p class="max-w-[46ch] text-[0.92rem] leading-[1.65] text-muted">{entry.copy}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <Section tone="tint" spacing="tight">
    <div class="grid items-end gap-8 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 data-reveal-title class="max-w-[14ch] pb-1 font-display text-[clamp(2.4rem,4.4vw,4.1rem)] font-light leading-[0.96] tracking-[-0.02em]">
          Start with the part you can smell.
        </h2>
        <p class="mt-5 max-w-[42ch] text-[0.95rem] leading-[1.7] text-muted">
          Koleksinya cukup kecil untuk dicoba dalam satu duduk. Pesan discovery set atau mulai dari
          material yang paling lama tinggal bersama Anda.
        </p>
      </div>
      <div data-reveal class="flex flex-col items-start gap-5 sm:flex-row sm:items-center lg:col-span-4 lg:col-start-9 lg:justify-end">
        <Button href="/collection/" class="w-full sm:w-auto">Explore the collection</Button>
        <ArrowLink href="/find/">Find your scent</ArrowLink>
      </div>
    </div>
  </Section>
</BaseLayout>
