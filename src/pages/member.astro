---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { MemberPortal } from '../components/member/MemberPortal';
---

<BaseLayout
  title="OMOO Loyalty Membership"
  description="Program loyalitas otomatis OMOO untuk kolektor wewangian: riwayat pesanan, gratis ongkos kirim, sampel 2 ml, dan akses batch terbatas."
>
  <PageHeader
    deck="Keanggotaan otomatis berdasarkan akumulasi pembelian Anda. Tanpa formulir pengajuan atau persetujuan manual."
  >
    <Fragment slot="title">OMOO <span class="italic">Membership</span>.</Fragment>
  </PageHeader>

  <section class="py-12 md:py-20 bg-bg">
    <div class="container">
      <MemberPortal client:load />
    </div>
  </section>
</BaseLayout>
