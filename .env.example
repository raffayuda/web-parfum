# ==============================================================================
# OMOO - Dynamic Fullstack Configuration
# ==============================================================================

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/omoo_db?schema=public"

# Backend Server (Elysia JS)
PORT=3001
NODE_ENV="development"
HOST="0.0.0.0"

# Frontend & Public URLs
PUBLIC_SITE_URL="http://localhost:4321"
PUBLIC_API_URL="http://localhost:3001"

# Better Auth Configuration
BETTER_AUTH_SECRET="omoo-super-secret-auth-key-change-this-in-production-32-chars-min"
BETTER_AUTH_URL="http://localhost:3001"

# Business & Payment Settings
QRIS_MERCHANT_NAME="OMOO STUDIO"
WHATSAPP_ADMIN_NUMBER="6281200000000"

# File Upload Directory
UPLOAD_DIR="./uploads"

# Brevo Transactional Email (OTP Registration)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@omoo.web.id"
BREVO_SENDER_NAME="OMOO"
